---
// Inventario — panel interno de gestión de stock
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Inventario — Procalzado</title>
<meta name="robots" content="noindex,nofollow"/>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<style>
:root{--red:#FF0000;--black:#000;--white:#fff;--grey:#F4F4F4;--grey2:#E0E0E0;--muted:#666;
  --c0-bg:#FECACA;--c0-tx:#991B1B;
  --clow-bg:#FEF08A;--clow-tx:#713F12;
  --cok-bg:#BBF7D0;--cok-tx:#14532D;
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Barlow',sans-serif;background:var(--grey);color:var(--black);min-height:100vh;font-size:14px}

/* LOGIN */
.login-wrap{display:flex;align-items:center;justify-content:center;min-height:100vh;padding:1rem}
.login-box{background:var(--white);border-radius:10px;padding:2rem;width:100%;max-width:340px;box-shadow:0 4px 20px rgba(0,0,0,.1);border-top:4px solid var(--red)}
.login-box h1{font-family:'Bebas Neue',sans-serif;font-size:1.7rem;margin-bottom:.2rem}
.login-box p{font-size:.8rem;color:var(--muted);margin-bottom:1.2rem}
.field{margin-bottom:.8rem}
.field label{display:block;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:.25rem}
.field input,.field select{width:100%;padding:.6rem .8rem;border:2px solid var(--grey2);border-radius:5px;font-size:.88rem;font-family:inherit;outline:none;transition:border-color .15s}
.field input:focus,.field select:focus{border-color:var(--red)}
.err-msg{background:#fee2e2;color:#991b1b;padding:.45rem .7rem;border-radius:5px;font-size:.78rem;margin-bottom:.7rem;display:none}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:.35rem;padding:.5rem 1rem;border:none;border-radius:5px;font-size:.8rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:opacity .15s;white-space:nowrap}
.btn:hover{opacity:.85}.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-red{background:var(--red);color:#fff}
.btn-black{background:var(--black);color:#fff}
.btn-green{background:#16a34a;color:#fff}
.btn-outline{background:transparent;border:2px solid var(--grey2);color:var(--black)}
.btn-outline:hover{border-color:#999;opacity:1}
.btn-w{width:100%;justify-content:center}

/* LAYOUT */
.inv{display:none;flex-direction:column;min-height:100vh}
.inv-header{background:var(--black);color:#fff;padding:.7rem 1.2rem;display:flex;align-items:center;gap:1rem}
.inv-header h2{font-family:'Bebas Neue',sans-serif;font-size:1.3rem;letter-spacing:.04em;flex:1}
.inv-header .ue{font-size:.75rem;opacity:.55}

/* TABS */
.tabs{background:#fff;border-bottom:2px solid var(--grey2);display:flex;padding:0 1.2rem}
.tab{padding:.6rem 1rem;font-weight:600;font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;color:var(--muted);transition:all .15s}
.tab.active{color:var(--red);border-bottom-color:var(--red)}

/* PANEL */
.panel{padding:1.2rem;max-width:1600px;margin:0 auto;width:100%}
.sec{display:none}
.sec.active{display:block}

/* TOOLBAR */
.toolbar{display:flex;gap:.6rem;flex-wrap:wrap;align-items:center;margin-bottom:.9rem}
.toolbar input[type=text]{padding:.5rem .8rem;border:2px solid var(--grey2);border-radius:5px;font-size:.82rem;font-family:inherit;outline:none;width:220px}
.toolbar input[type=text]:focus{border-color:var(--red)}
.toolbar select{padding:.5rem .7rem;border:2px solid var(--grey2);border-radius:5px;font-size:.8rem;font-family:inherit;outline:none;background:#fff}
.legend{display:flex;gap:.6rem;margin-left:auto;align-items:center}
.leg{display:flex;align-items:center;gap:.28rem;font-size:.72rem;color:var(--muted)}
.dot{width:9px;height:9px;border-radius:2px;border:1px solid rgba(0,0,0,.1)}

/* SUMMARY */
.sumbar{display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:.8rem}
.sum-chip{padding:.25rem .65rem;border-radius:4px;font-size:.73rem;font-weight:600;border:1px solid rgba(0,0,0,.08)}

/* TABLE */
.tbl-wrap{border:1px solid var(--grey2);border-radius:7px;overflow:hidden;overflow-x:auto;background:#fff}
table{width:100%;border-collapse:collapse;font-size:.82rem}
thead th{background:var(--black);color:#fff;padding:.5rem .75rem;text-align:left;font-size:.7rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap}
thead th:last-child{text-align:center;width:80px}
tbody td{padding:.45rem .75rem;border-bottom:1px solid var(--grey2);vertical-align:middle}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{background:#fafafa}
.p-name{font-weight:600}
.p-brand{font-size:.7rem;color:var(--muted)}

/* TALLAS */
.sizes-row{display:flex;flex-wrap:wrap;gap:.25rem}
.sz{display:inline-flex;flex-direction:column;align-items:center;border-radius:4px;padding:.18rem .38rem;font-size:.68rem;line-height:1.25;border:1px solid rgba(0,0,0,.1);min-width:30px}
.sz .n{font-weight:700;font-size:.72rem}
.sz .u{font-size:.62rem}
.sz.s0{background:var(--c0-bg);color:var(--c0-tx)}
.sz.slow{background:var(--clow-bg);color:var(--clow-tx)}
.sz.sok{background:var(--cok-bg);color:var(--cok-tx)}

/* TOTAL */
.tot{display:inline-block;min-width:36px;text-align:center;padding:.22rem .5rem;border-radius:4px;font-weight:700;font-size:.8rem;border:1px solid rgba(0,0,0,.1)}
.tot.t0{background:var(--c0-bg);color:var(--c0-tx)}
.tot.tlow{background:var(--clow-bg);color:var(--clow-tx)}
.tot.tok{background:var(--cok-bg);color:var(--cok-tx)}

/* FORMS */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}
.card{background:#fff;border-radius:7px;padding:1.2rem;border:1px solid var(--grey2)}
.card h3{font-family:'Bebas Neue',sans-serif;font-size:1.1rem;letter-spacing:.04em;margin-bottom:.9rem;border-bottom:2px solid var(--grey2);padding-bottom:.4rem}

/* FORM FIELDS */
.frow{display:flex;gap:.6rem;flex-wrap:wrap;align-items:flex-end;margin-bottom:.7rem}
.frow .field{margin-bottom:0;flex:1;min-width:130px}
.prod-search{position:relative}
.prod-search input{width:100%;padding:.6rem .8rem;border:2px solid var(--grey2);border-radius:5px;font-size:.85rem;font-family:inherit;outline:none}
.prod-search input:focus{border-color:var(--red)}
.qty-in{width:75px;padding:.55rem .6rem;border:2px solid var(--grey2);border-radius:5px;font-size:.9rem;font-family:inherit;outline:none;text-align:center}
.qty-in:focus{border-color:var(--red)}
.cur-stock{font-size:.78rem;color:var(--muted);margin:.3rem 0 .6rem}

/* BULK */
.bulk-wrap{border:1px solid var(--grey2);border-radius:5px;overflow:hidden;margin-bottom:.7rem}
.bulk-tbl{width:100%;border-collapse:collapse;font-size:.8rem}
.bulk-tbl th{background:var(--grey2);padding:.38rem .6rem;text-align:left;font-size:.68rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700}
.bulk-tbl td{padding:.32rem .5rem;border-top:1px solid var(--grey2)}
.bulk-tbl select{width:100%;padding:.3rem .4rem;border:1.5px solid var(--grey2);border-radius:4px;font-size:.78rem;font-family:inherit;outline:none}
.bulk-tbl select:focus{border-color:var(--red)}
.bulk-tbl input[type=number]{width:58px;padding:.3rem .35rem;border:1.5px solid var(--grey2);border-radius:4px;font-size:.8rem;text-align:center;font-family:inherit}
.bulk-tbl input:focus{border-color:var(--red);outline:none}
.rm-btn{background:none;border:none;color:#dc2626;cursor:pointer;font-size:.95rem;padding:0 .15rem;line-height:1}
.bulk-footer{display:flex;gap:.6rem;flex-wrap:wrap}

/* OVERLAY */
.overlay{position:fixed;inset:0;background:rgba(255,255,255,.78);display:none;align-items:center;justify-content:center;z-index:9998}
.spinner{width:30px;height:30px;border:3px solid var(--grey2);border-top-color:var(--red);border-radius:50%;animation:spin .55s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* TOAST */
.toast{position:fixed;bottom:1rem;right:1rem;background:var(--black);color:#fff;padding:.65rem 1rem;border-radius:6px;font-size:.8rem;z-index:9999;opacity:0;transform:translateY(5px);transition:all .22s;pointer-events:none;max-width:280px}
.toast.show{opacity:1;transform:none}
.toast.ok{border-left:4px solid #22c55e}
.toast.err{border-left:4px solid var(--red)}

@media(max-width:760px){.two-col{grid-template-columns:1fr}}
</style>
</head>
<body>

<div class="overlay" id="overlay"><div class="spinner"></div></div>

<!-- LOGIN -->
<div class="login-wrap" id="loginWrap">
  <div class="login-box">
    <h1>Inventario</h1>
    <p>Panel de gestion — Procalzado</p>
    <div class="err-msg" id="loginErr"></div>
    <div class="field"><label>Email</label><input type="email" id="loginEmail" autocomplete="email" placeholder="tu@email.com"/></div>
    <div class="field"><label>Contrasena</label><input type="password" id="loginPass" autocomplete="current-password" placeholder="••••••••"/></div>
    <button class="btn btn-red btn-w" id="loginBtn">Entrar</button>
  </div>
</div>

<!-- MAIN -->
<div class="inv" id="invPanel">
  <div class="inv-header">
    <h2>Inventario — Procalzado</h2>
    <div style="display:flex;align-items:center;gap:.7rem">
      <span class="ue" id="uEmail"></span>
      <button class="btn btn-outline" style="color:#fff;border-color:rgba(255,255,255,.25);font-size:.72rem" id="logoutBtn">Salir</button>
    </div>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="inventario">Inventario</div>
    <div class="tab" data-tab="ventas">Registrar Ventas</div>
    <div class="tab" data-tab="ingresos">Ingresos de Mercancia</div>
  </div>

  <div class="panel">

    <!-- TAB INVENTARIO -->
    <div class="sec active" id="tab-inventario">
      <div class="toolbar">
        <input type="text" id="searchQ" placeholder="Buscar producto o color..."/>
        <select id="fltStock">
          <option value="">Todos los stocks</option>
          <option value="0">Sin stock (rojo)</option>
          <option value="low">Stock bajo (amarillo)</option>
          <option value="ok">Stock OK (verde)</option>
        </select>
        <select id="fltBrand"><option value="">Todas las marcas</option></select>
        <div class="legend">
          <div class="leg"><div class="dot" style="background:var(--c0-bg)"></div>Sin stock</div>
          <div class="leg"><div class="dot" style="background:var(--clow-bg)"></div>Bajo (1-4)</div>
          <div class="leg"><div class="dot" style="background:var(--cok-bg)"></div>OK (5+)</div>
        </div>
        <button class="btn btn-black" id="exportBtn">Descargar Excel</button>
      </div>
      <div class="sumbar" id="sumbar"></div>
      <div class="tbl-wrap">
        <table>
          <thead>
            <tr>
              <th>Marca</th>
              <th>Producto</th>
              <th>Color</th>
              <th>Tallas y stock</th>
              <th>Total</th>
            </tr>
          </thead>
          <tbody id="invBody">
            <tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--muted)">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
      <div id="invCount" style="margin-top:.5rem;font-size:.72rem;color:var(--muted)"></div>
    </div>

    <!-- TAB VENTAS -->
    <div class="sec" id="tab-ventas">
      <div class="two-col">
        <div class="card">
          <h3>Venta individual</h3>
          <div class="field">
            <label>Buscar producto</label>
            <input type="text" id="saleProdSearch" placeholder="Escribe para filtrar..." autocomplete="off"/>
          </div>
          <div class="field">
            <label>Producto</label>
            <select id="saleProd"><option value="">Selecciona...</option></select>
          </div>
          <div class="field">
            <label>Color</label>
            <select id="saleColor" disabled><option value="">— primero producto —</option></select>
          </div>
          <div class="field">
            <label>Talla</label>
            <select id="saleSize" disabled><option value="">—</option></select>
          </div>
          <div class="cur-stock" id="saleCurStock"></div>
          <div style="display:flex;gap:.6rem;align-items:center">
            <input type="number" class="qty-in" id="saleQty" min="1" value="1"/>
            <button class="btn btn-red" id="saleSingleBtn">Descontar</button>
          </div>
        </div>

        <div class="card">
          <h3>Descuento masivo</h3>
          <div class="bulk-wrap">
            <table class="bulk-tbl">
              <thead><tr><th>Producto</th><th>Color</th><th>Talla</th><th>Cant.</th><th></th></tr></thead>
              <tbody id="saleBulkBody">
                <tr id="saleBulkEmpty"><td colspan="5" style="color:var(--muted);text-align:center;padding:.65rem;font-size:.78rem">Sin filas</td></tr>
              </tbody>
            </table>
          </div>
          <div class="bulk-footer">
            <button class="btn btn-outline" id="addSaleRow">+ Agregar fila</button>
            <button class="btn btn-red" id="saleBulkBtn">Aplicar descuentos</button>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB INGRESOS -->
    <div class="sec" id="tab-ingresos">
      <div class="two-col">
        <div class="card">
          <h3>Ingreso individual</h3>
          <div class="field">
            <label>Buscar producto</label>
            <input type="text" id="entryProdSearch" placeholder="Escribe para filtrar..." autocomplete="off"/>
          </div>
          <div class="field">
            <label>Producto</label>
            <select id="entryProd"><option value="">Selecciona...</option></select>
          </div>
          <div class="field">
            <label>Color</label>
            <select id="entryColor" disabled><option value="">— primero producto —</option></select>
          </div>
          <div class="field">
            <label>Talla</label>
            <select id="entrySize" disabled><option value="">—</option></select>
          </div>
          <div class="cur-stock" id="entryCurStock"></div>
          <div style="display:flex;gap:.6rem;align-items:center">
            <input type="number" class="qty-in" id="entryQty" min="1" value="1"/>
            <button class="btn btn-green" id="entrySingleBtn">Agregar</button>
          </div>
        </div>

        <div class="card">
          <h3>Ingreso masivo</h3>
          <div class="bulk-wrap">
            <table class="bulk-tbl">
              <thead><tr><th>Producto</th><th>Color</th><th>Talla</th><th>Cant.</th><th></th></tr></thead>
              <tbody id="entryBulkBody">
                <tr id="entryBulkEmpty"><td colspan="5" style="color:var(--muted);text-align:center;padding:.65rem;font-size:.78rem">Sin filas</td></tr>
              </tbody>
            </table>
          </div>
          <div class="bulk-footer">
            <button class="btn btn-outline" id="addEntryRow">+ Agregar fila</button>
            <button class="btn btn-green" id="entryBulkBtn">Aplicar ingresos</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>

<script is:inline define:vars={{sbUrl: import.meta.env.PUBLIC_SUPABASE_URL, sbAnon: import.meta.env.PUBLIC_SUPABASE_ANON_KEY}}>
(function(){
const LOW = 5;
const sb = window.supabase.createClient(sbUrl, sbAnon);
const $ = id => document.getElementById(id);

function loading(on){ $('overlay').style.display = on ? 'flex' : 'none'; }
function toast(msg, ok=true){
  const t=$('toast'); t.textContent=msg;
  t.className='toast show '+(ok?'ok':'err');
  clearTimeout(t._t); t._t=setTimeout(()=>t.className='toast',3200);
}
function scls(s){ return s<=0?'s0':s<LOW?'slow':'sok'; }
function tcls(s){ return s<=0?'t0':s<LOW?'tlow':'tok'; }

// AUTH
async function checkAuth(){
  const {data:{session}} = await sb.auth.getSession();
  if(session) showPanel(session.user.email);
}
$('loginBtn').addEventListener('click', async()=>{
  const em=$('loginEmail').value.trim(), pw=$('loginPass').value;
  if(!em||!pw){showErr('Completa todos los campos');return;}
  $('loginBtn').disabled=true;
  const {data,error}=await sb.auth.signInWithPassword({email:em,password:pw});
  if(error){showErr('Email o contrasena incorrectos');$('loginBtn').disabled=false;return;}
  showPanel(data.user.email);
});
$('loginPass').addEventListener('keydown',e=>{if(e.key==='Enter')$('loginBtn').click();});
$('logoutBtn').addEventListener('click',async()=>{
  await sb.auth.signOut();
  $('loginWrap').style.display=''; $('invPanel').style.display='none'; allData=null;
});
function showErr(m){const e=$('loginErr');e.textContent=m;e.style.display='block';}
async function showPanel(email){
  $('loginWrap').style.display='none';
  $('invPanel').style.display='flex';
  $('uEmail').textContent=email;
  await loadData();
}

// TABS
document.querySelectorAll('.tab').forEach(tab=>{
  tab.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
    document.querySelectorAll('.sec').forEach(s=>s.classList.remove('active'));
    tab.classList.add('active');
    $('tab-'+tab.dataset.tab).classList.add('active');
  });
});

// DATA
let allData=null;
async function fetchAll(table,select){
  let rows=[],offset=0;
  while(true){
    const {data}=await sb.from(table).select(select).range(offset,offset+999);
    if(!data||!data.length) break;
    rows.push(...data); if(data.length<1000) break; offset+=1000;
  }
  return rows;
}

async function loadData(){
  loading(true);
  try{
    const [products,variants]=await Promise.all([
      fetchAll('products','id,name,slug,brands(name)'),
      fetchAll('product_variants','id,product_id,color,size,stock,active'),
    ]);

    const productMap={};
    for(const p of products) productMap[p.id]=p;

    const byProd={};
    for(const v of variants){
      if(!v.active) continue;
      if(!byProd[v.product_id]) byProd[v.product_id]={};
      if(!byProd[v.product_id][v.color]) byProd[v.product_id][v.color]=[];
      byProd[v.product_id][v.color].push(v);
    }
    for(const pid in byProd)
      for(const c in byProd[pid])
        byProd[pid][c].sort((a,b)=>{const na=parseFloat(a.size),nb=parseFloat(b.size);return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);});

    allData={products,variants,productMap,byProd};

    // Brand filter
    const brands=[...new Set(products.map(p=>p.brands?.name).filter(Boolean))].sort();
    const bf=$('fltBrand');
    brands.forEach(b=>{const o=document.createElement('option');o.value=b;o.textContent=b;bf.appendChild(o);});

    // Populate product selects
    const sortedP=[...products].sort((a,b)=>{
      const ba=a.brands?.name||'', bb=b.brands?.name||'';
      return ba.localeCompare(bb)||a.name.localeCompare(b.name);
    });
    setupProductSelect('saleProd','saleColor','saleSize','saleCurStock','saleProdSearch',sortedP);
    setupProductSelect('entryProd','entryColor','entrySize','entryCurStock','entryProdSearch',sortedP);

    renderTable();
  }finally{loading(false);}
}

// RENDER TABLE
function renderTable(){
  if(!allData) return;
  const q=$('searchQ').value.toLowerCase().trim();
  const fs=$('fltStock').value;
  const fb=$('fltBrand').value;
  const {products,byProd}=allData;

  const rows=[];
  for(const p of products){
    const brand=p.brands?.name||'';
    if(fb&&brand!==fb) continue;
    const colorMap=byProd[p.id]||{};
    for(const [color,vs] of Object.entries(colorMap)){
      const lbl=(brand+' '+p.name+' '+color).toLowerCase();
      if(q&&!lbl.includes(q)) continue;
      const total=vs.reduce((s,v)=>s+(v.stock||0),0);
      if(fs==='0'&&!vs.some(v=>(v.stock||0)===0)) continue;
      if(fs==='low'&&!vs.some(v=>(v.stock||0)>0&&(v.stock||0)<LOW)) continue;
      if(fs==='ok'&&!vs.some(v=>(v.stock||0)>=LOW)) continue;
      rows.push({p,brand,color,vs,total});
    }
  }
  rows.sort((a,b)=>{
    const ba=a.brand||a.p.name, bb=b.brand||b.p.name;
    if(ba!==bb) return ba.localeCompare(bb);
    if(a.p.name!==b.p.name) return a.p.name.localeCompare(b.p.name);
    return a.color.localeCompare(b.color);
  });

  if(!rows.length){
    $('invBody').innerHTML='<tr><td colspan="5" style="text-align:center;padding:2rem;color:var(--muted)">Sin resultados</td></tr>';
    $('invCount').textContent=''; $('sumbar').innerHTML=''; return;
  }

  let n0=0,nLow=0,nOk=0,nUnits=0;
  $('invBody').innerHTML=rows.map(({p,brand,color,vs,total})=>{
    if(total===0) n0++; else if(total<LOW) nLow++; else nOk++;
    nUnits+=total;
    const badges=vs.map(v=>{
      const s=v.stock||0;
      return `<div class="sz ${scls(s)}"><span class="n">${v.size}</span><span class="u">${s}u</span></div>`;
    }).join('');
    return `<tr>
      <td style="font-size:.75rem;color:var(--muted);white-space:nowrap">${brand}</td>
      <td><span class="p-name">${p.name}</span></td>
      <td style="font-size:.8rem;white-space:nowrap">${color}</td>
      <td><div class="sizes-row">${badges}</div></td>
      <td style="text-align:center"><span class="tot ${tcls(total)}">${total}</span></td>
    </tr>`;
  }).join('');

  $('invCount').textContent=`${rows.length} variantes mostradas`;
  $('sumbar').innerHTML=
    `<span class="sum-chip" style="background:var(--c0-bg);color:var(--c0-tx)">Sin stock: ${n0}</span>`+
    `<span class="sum-chip" style="background:var(--clow-bg);color:var(--clow-tx)">Stock bajo: ${nLow}</span>`+
    `<span class="sum-chip" style="background:var(--cok-bg);color:var(--cok-tx)">Stock OK: ${nOk}</span>`+
    `<span class="sum-chip" style="background:var(--grey2)">Total unidades: ${nUnits}</span>`;
}

['searchQ','fltStock','fltBrand'].forEach(id=>$(id).addEventListener('input',renderTable));

// EXPORT XLSX
$('exportBtn').addEventListener('click',async()=>{
  if(!allData){toast('Sin datos',false);return;}
  loading(true);
  try{
    const {products,byProd}=allData;
    const wb=new ExcelJS.Workbook();
    const ws=wb.addWorksheet('Inventario');
    ws.columns=[
      {header:'Marca',key:'brand',width:16},{header:'Producto',key:'name',width:22},
      {header:'Color',key:'color',width:20},{header:'Talla',key:'size',width:8},{header:'Stock',key:'stock',width:9},
    ];
    ws.getRow(1).eachCell(c=>{c.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF000000'}};c.font={color:{argb:'FFFFFFFF'},bold:true};});
    const sp=[...products].sort((a,b)=>{const ba=a.brands?.name||a.name,bb=b.brands?.name||b.name;return ba.localeCompare(bb)||a.name.localeCompare(b.name);});
    for(const p of sp){
      for(const [color,vs] of Object.entries(byProd[p.id]||{})){
        for(const v of vs){
          const s=v.stock||0;
          const row=ws.addRow({brand:p.brands?.name||'',name:p.name,color,size:v.size,stock:s});
          const sc=row.getCell('stock');
          if(s===0){sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFFECACA'}};sc.font={color:{argb:'FF991B1B'},bold:true};}
          else if(s<LOW){sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFFEF08A'}};sc.font={color:{argb:'FF713F12'},bold:true};}
          else{sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFBBF7D0'}};sc.font={color:{argb:'FF14532D'},bold:true};}
        }
      }
    }
    const buf=await wb.xlsx.writeBuffer();
    const a=document.createElement('a');
    a.href=URL.createObjectURL(new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'}));
    a.download=`inventario-${new Date().toISOString().slice(0,10)}.xlsx`;
    a.click(); toast('Excel descargado');
  }catch(e){toast('Error al generar Excel',false);console.error(e);}
  finally{loading(false);}
});

// UPDATE STOCK
async function updateStock(vid,delta){
  const v=allData.variants.find(x=>x.id===vid);
  if(!v) throw new Error('Variante no encontrada');
  const ns=Math.max(0,(v.stock||0)+delta);
  const {error}=await sb.from('product_variants').update({stock:ns}).eq('id',vid);
  if(error) throw error;
  v.stock=ns; return ns;
}

// PRODUCT SELECT WITH SEARCH FILTER
function setupProductSelect(prodSelId, colorSelId, sizeSelId, curStockId, searchId, sortedProducts){
  const allOpts=sortedProducts.map(p=>({
    p,
    label: (p.brands?.name ? p.brands.name+' ' : '') + p.name
  }));

  function rebuildOpts(q){
    const sel=$(prodSelId);
    const prev=sel.value;
    sel.innerHTML='<option value="">Selecciona...</option>';
    const filtered=q ? allOpts.filter(o=>o.label.toLowerCase().includes(q.toLowerCase())) : allOpts;
    filtered.forEach(({p,label})=>{
      const o=document.createElement('option'); o.value=p.id; o.textContent=label; sel.appendChild(o);
    });
    if(prev && [...sel.options].some(o=>o.value===prev)) sel.value=prev;
  }

  $(searchId).addEventListener('input',()=>rebuildOpts($(searchId).value));

  $(prodSelId).addEventListener('change',()=>{
    const pid=$(prodSelId).value;
    $(colorSelId).innerHTML='<option value="">Selecciona color...</option>';
    $(sizeSelId).innerHTML='<option value="">—</option>';
    $(colorSelId).disabled=!pid; $(sizeSelId).disabled=true;
    $(curStockId).textContent='';
    if(!pid||!allData) return;
    const colors=Object.keys(allData.byProd[pid]||{}).sort();
    colors.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;$(colorSelId).appendChild(o);});
  });

  $(colorSelId).addEventListener('change',()=>{
    const pid=$(prodSelId).value, color=$(colorSelId).value;
    $(sizeSelId).innerHTML='<option value="">Selecciona talla...</option>';
    $(sizeSelId).disabled=!color; $(curStockId).textContent='';
    if(!pid||!color||!allData) return;
    const vs=allData.byProd[pid]?.[color]||[];
    vs.forEach(v=>{const o=document.createElement('option');o.value=v.id;o.textContent=`T${v.size}  (stock: ${v.stock||0})`;$(sizeSelId).appendChild(o);});
  });

  $(sizeSelId).addEventListener('change',()=>{
    const vid=$(sizeSelId).value;
    if(!vid||!allData){$(curStockId).textContent='';return;}
    const v=allData.variants.find(x=>x.id===vid);
    $(curStockId).textContent=v?`Stock actual: ${v.stock||0} unidades`:'';
  });

  rebuildOpts('');
}

// SINGLE OPS
$('saleSingleBtn').addEventListener('click',async()=>{
  const vid=$('saleSize').value, qty=parseInt($('saleQty').value)||0;
  if(!vid){toast('Selecciona producto / color / talla',false);return;}
  if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
  loading(true);
