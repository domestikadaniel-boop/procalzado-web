---
// Inventario
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Inventario — Procalzado</title>
<meta name="robots" content="noindex,nofollow"/>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<style is:global>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Barlow',sans-serif;background:#f0f0f0;color:#000;font-size:13px}

/* LOGIN */
.lw{display:flex;align-items:center;justify-content:center;min-height:100vh}
.lb{background:#fff;border-radius:8px;padding:2rem;width:340px;box-shadow:0 4px 16px rgba(0,0,0,.12);border-top:4px solid #f00}
.lb h1{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;margin-bottom:.2rem}
.lb p{font-size:.78rem;color:#666;margin-bottom:1.2rem}
.fl{margin-bottom:.7rem}
.fl label{display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.22rem}
.fl input[type=email],.fl input[type=password],.fl input[type=text],.fl select{width:100%;padding:.58rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.85rem;font-family:inherit;outline:none}
.fl input:focus,.fl select:focus{border-color:#f00}
.emsg{background:#fee2e2;color:#991b1b;padding:.4rem .65rem;border-radius:4px;font-size:.75rem;margin-bottom:.6rem;display:none}
.btn{display:inline-flex;align-items:center;gap:.3rem;padding:.5rem .95rem;border:none;border-radius:4px;font-size:.78rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:opacity .12s;white-space:nowrap}
.btn:hover{opacity:.85}.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-r{background:#f00;color:#fff}
.btn-b{background:#000;color:#fff}
.btn-g{background:#16a34a;color:#fff}
.btn-p{background:#7c3aed;color:#fff}
.btn-o{background:transparent;border:1.5px solid #ccc;color:#000}
.btn-o:hover{border-color:#666;opacity:1}
.btn-w{width:100%;justify-content:center}

/* LAYOUT */
.inv{display:none;flex-direction:column;min-height:100vh}
.hdr{background:#000;color:#fff;padding:.65rem 1.1rem;display:flex;align-items:center;gap:.8rem}
.hdr h2{font-family:'Bebas Neue',sans-serif;font-size:1.25rem;letter-spacing:.04em;flex:1}
.hdr .ue{font-size:.72rem;opacity:.5}

/* TABS */
.tabs{background:#fff;border-bottom:2px solid #ddd;display:flex;padding:0 1.1rem;flex-wrap:wrap}
.tab{padding:.58rem .95rem;font-weight:600;font-size:.75rem;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;color:#888;transition:all .12s}
.tab.active{color:#f00;border-bottom-color:#f00}

.panel{padding:1rem;max-width:1500px;margin:0 auto;width:100%}
.sec{display:none}.sec.active{display:block}

/* TOOLBAR */
.toolbar{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:.75rem}
.toolbar input[type=text]{padding:.48rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.8rem;font-family:inherit;outline:none;width:200px}
.toolbar input[type=text]:focus{border-color:#f00}
.toolbar select{padding:.48rem .65rem;border:1.5px solid #ddd;border-radius:4px;font-size:.78rem;font-family:inherit;outline:none;background:#fff}

/* SUMMARY */
.sumbar{display:flex;gap:.35rem;flex-wrap:wrap;margin-bottom:.65rem}
.chip{padding:.2rem .55rem;border-radius:3px;font-size:.7rem;font-weight:600;border:1px solid rgba(0,0,0,.1)}

/* TABLE */
.tw{border:1px solid #ccc;border-radius:6px;overflow:hidden;overflow-x:auto;background:#fff}
table{width:100%;border-collapse:collapse;font-size:.82rem}
thead th{background:#000;color:#fff;padding:.5rem .75rem;text-align:left;font-size:.7rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap;border-right:1px solid #444}
thead th:last-child{border-right:none}
thead th.num{text-align:center;width:80px}
tbody td{padding:.4rem .75rem;border-bottom:1px solid #d0d0d0;border-right:1px solid #d0d0d0;white-space:nowrap}
tbody td.num{text-align:center;font-weight:700;min-width:80px}
tbody td:last-child{border-right:none}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{filter:brightness(.96)}
.s0{background:#FECACA !important;color:#991B1B !important}
.slow{background:#FEF08A !important;color:#713F12 !important}
.sok{background:#BBF7D0 !important;color:#14532D !important}

/* LOCATION BADGES */
.loc-a{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#DBEAFE;color:#1D4ED8;letter-spacing:.04em}
.loc-b{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#F3E8FF;color:#7C3AED;letter-spacing:.04em}

/* FORMS */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.card{background:#fff;border-radius:6px;padding:1.1rem;border:1px solid #ddd}
.card h3{font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:.04em;margin-bottom:.85rem;border-bottom:2px solid #eee;padding-bottom:.35rem}
.frow{display:flex;gap:.5rem;align-items:flex-end;margin-top:.6rem;flex-wrap:wrap}
.cs{font-size:.76rem;color:#666;margin:.3rem 0 .5rem}
.qi{width:70px;padding:.5rem .5rem;border:1.5px solid #ddd;border-radius:4px;font-size:.88rem;font-family:inherit;outline:none;text-align:center}
.qi:focus{border-color:#f00;outline:none}
.loc-sel{padding:.5rem .65rem;border:1.5px solid #ddd;border-radius:4px;font-size:.8rem;font-family:inherit;outline:none;background:#fff}
.loc-sel:focus{border-color:#f00}

/* COMBOBOX */
.combo{position:relative}
.combo-inp{width:100%;padding:.5rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.85rem;font-family:inherit;outline:none}
.combo-inp:focus{border-color:#f00;border-radius:4px 4px 0 0}
.combo-dd{position:absolute;top:100%;left:0;right:0;background:#fff;border:1.5px solid #f00;border-top:none;border-radius:0 0 4px 4px;max-height:200px;overflow-y:auto;z-index:300;display:none;box-shadow:0 4px 12px rgba(0,0,0,.12)}
.combo-dd.open{display:block}
.combo-opt{padding:.42rem .75rem;cursor:pointer;font-size:.82rem;border-bottom:1px solid #f0f0f0}
.combo-opt:last-child{border-bottom:none}
.combo-opt:hover{background:#f5f5f5}
.combo-none{padding:.42rem .75rem;font-size:.82rem;color:#999}

/* BULK */
.bw{border:1px solid #ddd;border-radius:5px;overflow:hidden;margin-bottom:.65rem}
.bt{width:100%;border-collapse:collapse;font-size:.78rem}
.bt th{background:#eee;padding:.35rem .55rem;text-align:left;font-size:.67rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700;border-right:1px solid #ddd}
.bt th:last-child{border-right:none}
.bt td{padding:.3rem .45rem;border-top:1px solid #eee;border-right:1px solid #eee;vertical-align:top}
.bt td:last-child{border-right:none}
.bt select{width:100%;padding:.28rem .4rem;border:1.5px solid #ddd;border-radius:3px;font-size:.75rem;font-family:inherit;outline:none}
.bt select:focus{border-color:#f00}
.bt input[type=number]{width:54px;padding:.28rem .35rem;border:1.5px solid #ddd;border-radius:3px;font-size:.78rem;text-align:center;font-family:inherit}
.bt input:focus{border-color:#f00;outline:none}
.rm{background:none;border:none;color:#dc2626;cursor:pointer;font-size:.88rem;padding:0 .1rem;font-weight:700}
.bf{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem}

/* BULK COMBO */
.bcomb{min-width:140px}
.bcomb-inp{width:100%;padding:.28rem .4rem;border:1.5px solid #ddd;border-radius:3px;font-size:.75rem;font-family:inherit;outline:none}
.bcomb-inp:focus{border-color:#f00}
#_bDd{position:fixed;background:#fff;border:1.5px solid #f00;border-top:none;border-radius:0 0 4px 4px;max-height:220px;overflow-y:auto;z-index:9999;display:none;box-shadow:0 6px 16px rgba(0,0,0,.2)}
.bcomb-opt{padding:.35rem .5rem;cursor:pointer;font-size:.78rem;border-bottom:1px solid #f0f0f0}
.bcomb-opt:last-child{border-bottom:none}
.bcomb-opt:hover,.bcomb-opt:active{background:#f5f5f5}

/* HISTORY BADGES */
.mv-venta{display:inline-block;padding:.15rem .45rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#FEE2E2;color:#991B1B;letter-spacing:.04em;text-transform:uppercase}
.mv-ingreso{display:inline-block;padding:.15rem .45rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#BBF7D0;color:#14532D;letter-spacing:.04em;text-transform:uppercase}
.mv-transferencia{display:inline-block;padding:.15rem .45rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#F3E8FF;color:#7C3AED;letter-spacing:.04em;text-transform:uppercase}

/* TRANSFER */
.trf-card{background:#fff;border-radius:6px;padding:1.1rem;border:1px solid #ddd;max-width:520px}
.trf-arrow{display:flex;align-items:center;gap:.75rem;margin:.75rem 0}
.trf-arrow-icon{font-size:1.4rem;color:#7c3aed}
.trf-loc{flex:1;padding:.55rem .75rem;border:2px solid #ddd;border-radius:5px;font-size:.85rem;font-family:inherit;outline:none;background:#fff;font-weight:600}
.trf-loc:focus{border-color:#7c3aed}

/* OVERLAY */
.ov{position:fixed;inset:0;background:rgba(255,255,255,.75);display:none;align-items:center;justify-content:center;z-index:9998}
.sp{width:28px;height:28px;border:3px solid #ddd;border-top-color:#f00;border-radius:50%;animation:sp .5s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

/* TOAST */
.toast{position:fixed;bottom:1rem;right:1rem;background:#000;color:#fff;padding:.6rem .9rem;border-radius:5px;font-size:.78rem;z-index:9999;opacity:0;transform:translateY(5px);transition:all .2s;pointer-events:none;max-width:270px}
.toast.show{opacity:1;transform:none}
.toast.ok{border-left:4px solid #22c55e}
.toast.err{border-left:4px solid #f00}

/* PRÉSTAMOS */
.ln-prestado{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#FEF3C7;color:#92400E;letter-spacing:.04em;text-transform:uppercase}
.ln-recibido{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#E0E7FF;color:#3730A3;letter-spacing:.04em;text-transform:uppercase}
.ln-pagado{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#BBF7D0;color:#14532D;letter-spacing:.04em;text-transform:uppercase}
.ln-devuelto{display:inline-block;padding:.1rem .4rem;border-radius:3px;font-size:.65rem;font-weight:700;background:#DBEAFE;color:#1D4ED8;letter-spacing:.04em;text-transform:uppercase}

@media(max-width:760px){.two-col{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="ov" id="ov"><div class="sp"></div></div>

<!-- LOGIN -->
<div class="lw" id="lw">
  <div class="lb">
    <h1>Inventario</h1>
    <p>Panel de gestion — Procalzado</p>
    <div class="emsg" id="lerr"></div>
    <div class="fl"><label>Email</label><input type="email" id="lem" autocomplete="email" placeholder="tu@email.com"/></div>
    <div class="fl"><label>Contrasena</label>
      <div style="position:relative">
        <input type="password" id="lpw" autocomplete="current-password" placeholder="••••••••" style="padding-right:2.4rem"/>
        <button type="button" id="eyeBtn" style="position:absolute;right:.55rem;top:50%;transform:translateY(-50%);background:none;border:none;outline:none;cursor:pointer;color:#aaa;padding:0;line-height:1" tabindex="-1">
          <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
      </div>
    </div>
    <div class="cf-turnstile" data-sitekey="0x4AAAAAADnyx1B9r_FPdBeB" data-callback="onTurnstileSuccess" style="margin-bottom:.8rem"></div>
    <button class="btn btn-r btn-w" id="lbtn">Entrar</button>
  </div>
</div>

<!-- MAIN -->
<div class="inv" id="invP">
  <div class="hdr">
    <h2>Inventario — Procalzado</h2>
    <span class="ue" id="uem"></span>
    <button class="btn btn-o" style="color:#fff;border-color:rgba(255,255,255,.2);font-size:.7rem" id="logoutBtn">Salir</button>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="inv">Inventario</div>
    <div class="tab" data-tab="ven">Registrar Ventas</div>
    <div class="tab" data-tab="ing">Ingresos de Mercancia</div>
    <div class="tab" data-tab="loan">Préstamos</div>
    <div class="tab" data-tab="his">Historial</div>
    <div class="tab" data-tab="ml">MercadoLibre</div>
  </div>

  <div class="panel">

    <!-- INVENTARIO -->
    <div class="sec active" id="tab-inv">
      <div class="toolbar">
        <input type="text" id="sq" placeholder="Buscar producto..."/>
        <select id="fst">
          <option value="">Todos los stocks</option>
          <option value="0">Sin stock</option>
          <option value="low">Stock bajo (1-4)</option>
          <option value="ok">Stock OK (5+)</option>
        </select>
        <select id="fbr"><option value="">Todas las marcas</option></select>
        <button class="btn btn-o" id="reloadBtn">Recargar datos</button>
        <button class="btn btn-b" id="exBtn">Descargar Excel</button>
      </div>
      <div class="sumbar" id="sb"></div>
      <div class="tw">
        <table>
          <thead>
            <tr>
              <th>Marca</th>
              <th>Producto</th>
              <th>Color</th>
              <th>Talla</th>
              <th class="num">Stock Procalzado</th>
            </tr>
          </thead>
          <tbody id="tb">
            <tr><td colspan="5" style="text-align:center;padding:2rem;color:#888">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
      <div id="cnt" style="margin-top:.45rem;font-size:.7rem;color:#888"></div>
    </div>

    <!-- VENTAS -->
    <div class="sec" id="tab-ven">
      <div class="card">
        <h3>Venta individual</h3>
        <div class="fl">
          <label>Producto</label>
          <div class="combo" id="sPC">
            <input type="text" class="combo-inp" id="sCInp" placeholder="Buscar producto..." autocomplete="off"/>
            <div class="combo-dd" id="sCDd"></div>
          </div>
        </div>
        <div class="fl"><label>Color</label><select id="sCol" disabled><option value="">— primero producto —</option></select></div>
        <div class="fl"><label>Talla</label><select id="sSz" disabled><option value="">—</option></select></div>
        <div class="cs" id="sCS"></div>
        <div class="frow">
          <input type="number" class="qi" id="sQty" min="1" value="1"/>
          <button class="btn btn-r" id="sSingle">Descontar</button>
        </div>
      </div>
      <div class="card" style="margin-top:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem;border-bottom:2px solid #eee;padding-bottom:.35rem">
          <h3 style="margin:0;font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:.04em">Descuento masivo</h3>
          <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
            <button class="btn btn-o" id="vzSAddProd">+ Agregar producto</button>
          </div>
        </div>
        <div id="vzSBlocks" style="display:flex;flex-direction:column;gap:.75rem"></div>
        <div id="vzSApplyWrap" hidden style="margin-top:.75rem">
          <button class="btn btn-r" id="vzSApply">Aplicar descuentos</button>
        </div>
      </div>
    </div>

    <!-- INGRESOS -->
    <div class="sec" id="tab-ing">
      <div class="card">
        <h3>Ingreso individual</h3>
        <div class="fl">
          <label>Producto</label>
          <div class="combo" id="ePC">
            <input type="text" class="combo-inp" id="eCInp" placeholder="Buscar producto..." autocomplete="off"/>
            <div class="combo-dd" id="eCDd"></div>
          </div>
        </div>
        <div class="fl"><label>Color</label><select id="eCol" disabled><option value="">— primero producto —</option></select></div>
        <div class="fl"><label>Talla</label><select id="eSz" disabled><option value="">—</option></select></div>
        <div class="cs" id="eCS"></div>
        <div class="frow">
          <input type="number" class="qi" id="eQty" min="1" value="1"/>
          <button class="btn btn-g" id="eSingle">Agregar</button>
        </div>
      </div>
      <div class="card" style="margin-top:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem;margin-bottom:.85rem;border-bottom:2px solid #eee;padding-bottom:.35rem">
          <h3 style="margin:0;font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:.04em">Ingreso masivo</h3>
          <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
            <button class="btn btn-o" id="vzEAddProd">+ Agregar producto</button>
          </div>
        </div>
        <div id="vzEBlocks" style="display:flex;flex-direction:column;gap:.75rem"></div>
        <div id="vzEApplyWrap" hidden style="margin-top:.75rem">
          <button class="btn btn-g" id="vzEApply">Aplicar ingresos</button>
        </div>
      </div>
    </div>

    <!-- PRÉSTAMOS -->
    <div class="sec" id="tab-loan">
      <div class="card" style="margin-bottom:1rem">
        <h3>Registrar préstamo</h3>
        <div style="display:flex;gap:1.5rem;margin-bottom:.9rem;flex-wrap:wrap">
          <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.82rem;font-weight:600">
            <input type="radio" name="lnType" id="lnTypeP" value="prestado" checked> Prestamos a alguien
          </label>
          <label style="display:flex;align-items:center;gap:.4rem;cursor:pointer;font-size:.82rem;font-weight:600">
            <input type="radio" name="lnType" id="lnTypeR" value="recibido"> Nos prestan a nosotros
          </label>
        </div>
        <div class="two-col" style="gap:.75rem">
          <div>
            <div class="fl">
              <label>Persona / empresa</label>
              <input type="text" class="combo-inp" id="lnPerson" placeholder="¿A quién prestamos / quién nos presta?"/>
            </div>
            <div class="fl">
              <label>Producto</label>
              <div class="combo">
                <input type="text" class="combo-inp" id="lnCInp" placeholder="Buscar producto..." autocomplete="off"/>
                <div class="combo-dd" id="lnCDd"></div>
              </div>
            </div>
            <div class="fl"><label>Color</label><select id="lnCol" class="loc-sel" style="width:100%" disabled><option value="">— primero producto —</option></select></div>
            <div class="fl"><label>Talla</label><select id="lnSz" class="loc-sel" style="width:100%" disabled><option value="">—</option></select></div>
            <div class="cs" id="lnCS"></div>
          </div>
          <div>
            <div class="fl"><label>Cantidad</label><input type="number" class="qi" id="lnQty" min="1" value="1" style="width:100%"/></div>
            <div class="fl"><label>Notas (fecha compromiso, etc.)</label><input type="text" class="combo-inp" id="lnNotes" placeholder="Opcional..."/></div>
            <div style="margin-top:.75rem"><button class="btn btn-p btn-w" id="lnBtn">Registrar préstamo</button></div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-bottom:1rem">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
          <h3 style="margin:0">Préstamos pendientes</h3>
          <span id="lnPendCnt" style="font-size:.75rem;color:#888"></span>
        </div>
        <div class="tw"><table>
          <thead><tr>
            <th>Fecha</th><th>Tipo</th><th>Persona</th><th>Producto</th>
            <th>Color / Talla</th><th class="num">Cant.</th><th>Notas</th><th></th>
          </tr></thead>
          <tbody id="lnPendTb"><tr><td colspan="8" style="text-align:center;padding:2rem;color:#888">Sin préstamos pendientes</td></tr></tbody>
        </table></div>
      </div>

      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
          <h3 style="margin:0">Historial de préstamos</h3>
          <span id="lnHistCnt" style="font-size:.75rem;color:#888"></span>
        </div>
        <div class="tw"><table>
          <thead><tr>
            <th>Fecha</th><th>Tipo</th><th>Persona</th><th>Producto</th>
            <th>Color / Talla</th><th class="num">Cant.</th><th>Resolución</th><th>Notas</th>
          </tr></thead>
          <tbody id="lnHistTb"><tr><td colspan="8" style="text-align:center;padding:2rem;color:#888">Sin historial</td></tr></tbody>
        </table></div>
      </div>
    </div>

    <!-- HISTORIAL -->
    <div class="sec" id="tab-his">
      <div class="toolbar">
        <select id="hftype">
          <option value="">Todos los movimientos</option>
          <option value="venta">Ventas</option>
          <option value="ingreso">Ingresos</option>
        </select>
        <input type="text" id="hfsq" placeholder="Buscar producto..."/>
        <button class="btn btn-o" id="hReloadBtn">Recargar</button>
      </div>
      <div class="tw">
        <table>
