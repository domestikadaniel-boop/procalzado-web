    $('saleCurStock').textContent=`Stock actual: ${ns} unidades`;
    const o=$('saleSize').selectedOptions[0];
    const v=allData.variants.find(x=>x.id===vid);
    if(o&&v) o.textContent=`T${v.size}  (stock: ${ns})`;
    renderTable();
  }catch(e){toast('Error: '+e.message,false);}
