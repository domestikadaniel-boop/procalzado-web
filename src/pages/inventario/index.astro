// ── BULK ROWS ──
function buildVariantLabel(vid) {
  if (!allData || !vid) return '';
  const v = allData.variants.find(x => x.id === vid);
  if (!v) return vid;
  const p = allData.products.find(x => x.id === v.product_id);
  return `${p?.name || ''} / ${v.color} / T${v.size}`;
}

function addBulkRow(tbodyId, emptyRowId) {
  if (!allData) { showToast('Carga los datos primero', false); return; }
  const emptyRow = $(emptyRowId);
  if (emptyRow) emptyRow.style.display = 'none';

  const tbody = $(tbodyId);
  const tr = document.createElement('tr');
  tr.dataset.vid = '';

  // Product select
  const prodSel = document.createElement('select');
  prodSel.style.cssText = 'width:100%;border:1.5px solid var(--grey2);border-radius:4px;padding:.3rem .5rem;font-size:.82rem;font-family:inherit';
  prodSel.innerHTML = '<option value="">Producto…</option>';
  [...allData.products].sort((a, b) => a.name.localeCompare(b.name)).forEach(p => {
    const o = document.createElement('option');
    o.value = p.id;
    o.textContent = (p.brands?.name ? p.brands.name + ' ' : '') + p.name;
    prodSel.appendChild(o);
  });

  const colorSel = document.createElement('select');
  colorSel.style.cssText = prodSel.style.cssText;
  colorSel.innerHTML = '<option value="">Color…</option>';
  colorSel.disabled = true;

  const sizeSel = document.createElement('select');
  sizeSel.style.cssText = prodSel.style.cssText;
  sizeSel.innerHTML = '<option value="">Talla…</option>';
  sizeSel.disabled = true;

  prodSel.addEventListener('change', () => {
    colorSel.innerHTML = '<option value="">Color…</option>';
    sizeSel.innerHTML = '<option value="">Talla…</option>';
    colorSel.disabled = !prodSel.value;
    sizeSel.disabled = true;
    tr.dataset.vid = '';
    if (!prodSel.value) return;
    const colors = Object.keys(allData.variantsByProduct[prodSel.value] || {}).sort();
    colors.forEach(c => { const o = document.createElement('option'); o.value = c; o.textContent = c; colorSel.appendChild(o); });
  });

  colorSel.addEventListener('change', () => {
    sizeSel.innerHTML = '<option value="">Talla…</option>';
    sizeSel.disabled = !colorSel.value;
    tr.dataset.vid = '';
    const variants = allData.variantsByProduct[prodSel.value]?.[colorSel.value] || [];
    variants.forEach(v => {
      const o = document.createElement('option'); o.value = v.id;
      o.textContent = `T${v.size} (stock: ${v.stock || 0})`;
      sizeSel.appendChild(o);
    });
  });

  sizeSel.addEventListener('change', () => { tr.dataset.vid = sizeSel.value; });

  const qtyInput = document.createElement('input');
  qtyInput.type = 'number'; qtyInput.min = '1'; qtyInput.value = '1';
  qtyInput.className = 'qty-input'; qtyInput.style.width = '60px';

  const removeBtn = document.createElement('button');
  removeBtn.className = 'remove-row'; removeBtn.textContent = '✕';
  removeBtn.addEventListener('click', () => {
    tr.remove();
    if (!tbody.querySelectorAll('tr:not([id])').length) {
      $(emptyRowId).style.display = '';
    }
  });

  const selCell = document.createElement('td');
  selCell.style.cssText = 'display:flex;flex-direction:column;gap:.25rem;min-width:200px';
  selCell.append(prodSel, colorSel, sizeSel);

  const qtyCell = document.createElement('td');
  qtyCell.appendChild(qtyInput);

  const removeCell = document.createElement('td');
  removeCell.appendChild(removeBtn);

  tr.append(selCell, qtyCell, removeCell);
  tbody.appendChild(tr);
}

$('addBulkRowBtn').addEventListener('click', () => addBulkRow('bulkBody', 'bulkEmptyRow'));
$('addEntryRowBtn').addEventListener('click', () => addBulkRow('entryBulkBody', 'entryBulkEmptyRow'));

async function applyBulk(tbodyId, delta, emptyRowId) {
  const rows = [...$(tbodyId).querySelectorAll('tr:not([id])')];
  if (!rows.length) { showToast('No hay filas para procesar', false); return; }

  const ops = [];
  for (const tr of rows) {
    const vid = tr.dataset.vid;
    const qty = parseInt(tr.querySelector('input[type=number]').value) || 0;
    if (!vid || qty <= 0) continue;
    ops.push({ vid, qty: delta * qty });
  }

  if (!ops.length) { showToast('Completa las filas (producto, color, talla, cantidad)', false); return; }

  showLoading(true);
  try {
    let ok = 0;
    for (const op of ops) {
      await updateStock(op.vid, op.qty);
      ok++;
    }
    showToast(`${ok} variantes actualizadas ✓`);
    // Clear rows
    $(tbodyId).querySelectorAll('tr:not([id])').forEach(r => r.remove());
    $(emptyRowId).style.display = '';
    renderTable();
  } catch(e) {
    showToast('Error: ' + e.message, false);
  } finally {
    showLoading(false);
  }
}

$('bulkSaveBtn').addEventListener('click', () => applyBulk('bulkBody', -1, 'bulkEmptyRow'));
$('entryBulkSaveBtn').addEventListener('click', () => applyBulk('entryBulkBody', 1, 'entryBulkEmptyRow'));

// ── INIT ──
checkAuth();
})();
