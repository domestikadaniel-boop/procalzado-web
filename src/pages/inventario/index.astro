---
// Inventario
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Inventario — Procalzado</title>
<meta name="robots" content="noindex,nofollow"/>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Bebas+Neue&display=swap" rel="stylesheet"/>
<script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<style is:global>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Barlow',sans-serif;background:#f0f0f0;color:#000;font-size:13px}

/* LOGIN */
.lw{display:flex;align-items:center;justify-content:center;min-height:100vh}
.lb{background:#fff;border-radius:8px;padding:2rem;width:340px;box-shadow:0 4px 16px rgba(0,0,0,.12);border-top:4px solid #f00}
.lb h1{font-family:'Bebas Neue',sans-serif;font-size:1.6rem;margin-bottom:.2rem}
.lb p{font-size:.78rem;color:#666;margin-bottom:1.2rem}
.fl{margin-bottom:.7rem}
.fl label{display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.22rem}
.fl input[type=email],.fl input[type=password],.fl select{width:100%;padding:.58rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.85rem;font-family:inherit;outline:none}
.fl input:focus,.fl select:focus{border-color:#f00}
.emsg{background:#fee2e2;color:#991b1b;padding:.4rem .65rem;border-radius:4px;font-size:.75rem;margin-bottom:.6rem;display:none}
.btn{display:inline-flex;align-items:center;gap:.3rem;padding:.5rem .95rem;border:none;border-radius:4px;font-size:.78rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;font-family:inherit;transition:opacity .12s;white-space:nowrap}
.btn:hover{opacity:.85}.btn:disabled{opacity:.4;cursor:not-allowed}
.btn-r{background:#f00;color:#fff}
.btn-b{background:#000;color:#fff}
.btn-g{background:#16a34a;color:#fff}
.btn-o{background:transparent;border:1.5px solid #ccc;color:#000}
.btn-o:hover{border-color:#666;opacity:1}
.btn-w{width:100%;justify-content:center}

/* LAYOUT */
.inv{display:none;flex-direction:column;min-height:100vh}
.hdr{background:#000;color:#fff;padding:.65rem 1.1rem;display:flex;align-items:center;gap:.8rem}
.hdr h2{font-family:'Bebas Neue',sans-serif;font-size:1.25rem;letter-spacing:.04em;flex:1}
.hdr .ue{font-size:.72rem;opacity:.5}

/* TABS */
.tabs{background:#fff;border-bottom:2px solid #ddd;display:flex;padding:0 1.1rem}
.tab{padding:.58rem .95rem;font-weight:600;font-size:.75rem;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;border-bottom:3px solid transparent;margin-bottom:-2px;color:#888;transition:all .12s}
.tab.active{color:#f00;border-bottom-color:#f00}

.panel{padding:1rem;max-width:1500px;margin:0 auto;width:100%}
.sec{display:none}.sec.active{display:block}

/* TOOLBAR */
.toolbar{display:flex;gap:.5rem;flex-wrap:wrap;align-items:center;margin-bottom:.75rem}
.toolbar input[type=text]{padding:.48rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.8rem;font-family:inherit;outline:none;width:200px}
.toolbar input[type=text]:focus{border-color:#f00}
.toolbar select{padding:.48rem .65rem;border:1.5px solid #ddd;border-radius:4px;font-size:.78rem;font-family:inherit;outline:none;background:#fff}

/* SUMMARY */
.sumbar{display:flex;gap:.35rem;flex-wrap:wrap;margin-bottom:.65rem}
.chip{padding:.2rem .55rem;border-radius:3px;font-size:.7rem;font-weight:600;border:1px solid rgba(0,0,0,.1)}

/* TABLE */
.tw{border:1px solid #ccc;border-radius:6px;overflow:hidden;overflow-x:auto;background:#fff}
table{width:100%;border-collapse:collapse;font-size:.82rem}
thead th{background:#000;color:#fff;padding:.5rem .75rem;text-align:left;font-size:.7rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;white-space:nowrap;border-right:1px solid #444}
thead th:last-child{border-right:none;text-align:center;width:100px}
tbody td{padding:.4rem .75rem;border-bottom:1px solid #d0d0d0;border-right:1px solid #d0d0d0;white-space:nowrap}
tbody td:last-child{border-right:none;text-align:center;font-weight:700;min-width:100px}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover td{filter:brightness(.96)}
.s0{background:#FECACA !important;color:#991B1B !important}
.slow{background:#FEF08A !important;color:#713F12 !important}
.sok{background:#BBF7D0 !important;color:#14532D !important}

/* FORMS */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:1rem}
.card{background:#fff;border-radius:6px;padding:1.1rem;border:1px solid #ddd}
.card h3{font-family:'Bebas Neue',sans-serif;font-size:1.05rem;letter-spacing:.04em;margin-bottom:.85rem;border-bottom:2px solid #eee;padding-bottom:.35rem}
.frow{display:flex;gap:.5rem;align-items:flex-end;margin-top:.6rem}
.cs{font-size:.76rem;color:#666;margin:.3rem 0 .5rem}
.qi{width:70px;padding:.5rem .5rem;border:1.5px solid #ddd;border-radius:4px;font-size:.88rem;font-family:inherit;outline:none;text-align:center}
.qi:focus{border-color:#f00}

/* COMBOBOX */
.combo{position:relative}
.combo-inp{width:100%;padding:.5rem .75rem;border:1.5px solid #ddd;border-radius:4px;font-size:.85rem;font-family:inherit;outline:none}
.combo-inp:focus{border-color:#f00;border-radius:4px 4px 0 0}
.combo-dd{position:absolute;top:100%;left:0;right:0;background:#fff;border:1.5px solid #f00;border-top:none;border-radius:0 0 4px 4px;max-height:200px;overflow-y:auto;z-index:300;display:none;box-shadow:0 4px 12px rgba(0,0,0,.12)}
.combo-dd.open{display:block}
.combo-opt{padding:.42rem .75rem;cursor:pointer;font-size:.82rem;border-bottom:1px solid #f0f0f0}
.combo-opt:last-child{border-bottom:none}
.combo-opt:hover{background:#f5f5f5}
.combo-none{padding:.42rem .75rem;font-size:.82rem;color:#999}

/* BULK */
.bw{border:1px solid #ddd;border-radius:5px;overflow:hidden;margin-bottom:.65rem}
.bt{width:100%;border-collapse:collapse;font-size:.78rem}
.bt th{background:#eee;padding:.35rem .55rem;text-align:left;font-size:.67rem;text-transform:uppercase;letter-spacing:.05em;font-weight:700;border-right:1px solid #ddd}
.bt th:last-child{border-right:none}
.bt td{padding:.3rem .45rem;border-top:1px solid #eee;border-right:1px solid #eee;vertical-align:top}
.bt td:last-child{border-right:none}
.bt select{width:100%;padding:.28rem .4rem;border:1.5px solid #ddd;border-radius:3px;font-size:.75rem;font-family:inherit;outline:none}
.bt select:focus{border-color:#f00}
.bt input[type=number]{width:54px;padding:.28rem .35rem;border:1.5px solid #ddd;border-radius:3px;font-size:.78rem;text-align:center;font-family:inherit}
.bt input:focus{border-color:#f00;outline:none}
.rm{background:none;border:none;color:#dc2626;cursor:pointer;font-size:.88rem;padding:0 .1rem;font-weight:700}
.bf{display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.5rem}

/* BULK COMBO */
.bcomb{position:relative;min-width:140px}
.bcomb-inp{width:100%;padding:.28rem .4rem;border:1.5px solid #ddd;border-radius:3px;font-size:.75rem;font-family:inherit;outline:none}
.bcomb-inp:focus{border-color:#f00}
.bcomb-dd{position:fixed;background:#fff;border:1.5px solid #f00;border-top:none;border-radius:0 0 3px 3px;max-height:200px;overflow-y:auto;z-index:9990;display:none;box-shadow:0 4px 12px rgba(0,0,0,.18)}
.bcomb-dd.open{display:block}
.bcomb-opt{padding:.32rem .5rem;cursor:pointer;font-size:.75rem;border-bottom:1px solid #f0f0f0}
.bcomb-opt:last-child{border-bottom:none}
.bcomb-opt:hover{background:#f5f5f5}

/* OVERLAY */
.ov{position:fixed;inset:0;background:rgba(255,255,255,.75);display:none;align-items:center;justify-content:center;z-index:9998}
.sp{width:28px;height:28px;border:3px solid #ddd;border-top-color:#f00;border-radius:50%;animation:sp .5s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

/* TOAST */
.toast{position:fixed;bottom:1rem;right:1rem;background:#000;color:#fff;padding:.6rem .9rem;border-radius:5px;font-size:.78rem;z-index:9999;opacity:0;transform:translateY(5px);transition:all .2s;pointer-events:none;max-width:270px}
.toast.show{opacity:1;transform:none}
.toast.ok{border-left:4px solid #22c55e}
.toast.err{border-left:4px solid #f00}

@media(max-width:760px){.two-col{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="ov" id="ov"><div class="sp"></div></div>

<!-- LOGIN -->
<div class="lw" id="lw">
  <div class="lb">
    <h1>Inventario</h1>
    <p>Panel de gestion — Procalzado</p>
    <div class="emsg" id="lerr"></div>
    <div class="fl"><label>Email</label><input type="email" id="lem" autocomplete="email" placeholder="tu@email.com"/></div>
    <div class="fl"><label>Contrasena</label><input type="password" id="lpw" autocomplete="current-password" placeholder="••••••••"/></div>
    <button class="btn btn-r btn-w" id="lbtn">Entrar</button>
  </div>
</div>

<!-- MAIN -->
<div class="inv" id="invP">
  <div class="hdr">
    <h2>Inventario — Procalzado</h2>
    <span class="ue" id="uem"></span>
    <button class="btn btn-o" style="color:#fff;border-color:rgba(255,255,255,.2);font-size:.7rem" id="logoutBtn">Salir</button>
  </div>

  <div class="tabs">
    <div class="tab active" data-tab="inv">Inventario</div>
    <div class="tab" data-tab="ven">Registrar Ventas</div>
    <div class="tab" data-tab="ing">Ingresos de Mercancia</div>
  </div>

  <div class="panel">

    <!-- INVENTARIO -->
    <div class="sec active" id="tab-inv">
      <div class="toolbar">
        <input type="text" id="sq" placeholder="Buscar producto..."/>
        <select id="fst">
          <option value="">Todos los stocks</option>
          <option value="0">Sin stock</option>
          <option value="low">Stock bajo (1-4)</option>
          <option value="ok">Stock OK (5+)</option>
        </select>
        <select id="fbr"><option value="">Todas las marcas</option></select>
        <button class="btn btn-b" id="exBtn">Descargar Excel</button>
      </div>
      <div class="sumbar" id="sb"></div>
      <div class="tw">
        <table>
          <thead>
            <tr>
              <th>Marca</th>
              <th>Producto</th>
              <th>Color</th>
              <th>Talla</th>
              <th>Stock</th>
            </tr>
          </thead>
          <tbody id="tb">
            <tr><td colspan="5" style="text-align:center;padding:2rem;color:#888">Cargando...</td></tr>
          </tbody>
        </table>
      </div>
      <div id="cnt" style="margin-top:.45rem;font-size:.7rem;color:#888"></div>
    </div>

    <!-- VENTAS -->
    <div class="sec" id="tab-ven">
      <div class="two-col">
        <div class="card">
          <h3>Venta individual</h3>
          <div class="fl">
            <label>Producto</label>
            <div class="combo" id="sPC">
              <input type="text" class="combo-inp" id="sCInp" placeholder="Buscar producto..." autocomplete="off"/>
              <div class="combo-dd" id="sCDd"></div>
            </div>
          </div>
          <div class="fl"><label>Color</label><select id="sCol" disabled><option value="">— primero producto —</option></select></div>
          <div class="fl"><label>Talla</label><select id="sSz" disabled><option value="">—</option></select></div>
          <div class="cs" id="sCS"></div>
          <div class="frow">
            <input type="number" class="qi" id="sQty" min="1" value="1"/>
            <button class="btn btn-r" id="sSingle">Descontar</button>
          </div>
        </div>
        <div class="card">
          <h3>Descuento masivo</h3>
          <div class="bw"><table class="bt">
            <thead><tr><th>Producto</th><th>Color</th><th>Talla</th><th>Cant.</th><th></th></tr></thead>
            <tbody id="sBulkBody"><tr id="sBE"><td colspan="5" style="color:#888;text-align:center;padding:.6rem;font-size:.75rem">Sin filas</td></tr></tbody>
          </table></div>
          <div class="bf">
            <button class="btn btn-o" id="addSR">+ Fila</button>
            <button class="btn btn-r" id="sBulk">Aplicar descuentos</button>
          </div>
        </div>
      </div>
    </div>

    <!-- INGRESOS -->
    <div class="sec" id="tab-ing">
      <div class="two-col">
        <div class="card">
          <h3>Ingreso individual</h3>
          <div class="fl">
            <label>Producto</label>
            <div class="combo" id="ePC">
              <input type="text" class="combo-inp" id="eCInp" placeholder="Buscar producto..." autocomplete="off"/>
              <div class="combo-dd" id="eCDd"></div>
            </div>
          </div>
          <div class="fl"><label>Color</label><select id="eCol" disabled><option value="">— primero producto —</option></select></div>
          <div class="fl"><label>Talla</label><select id="eSz" disabled><option value="">—</option></select></div>
          <div class="cs" id="eCS"></div>
          <div class="frow">
            <input type="number" class="qi" id="eQty" min="1" value="1"/>
            <button class="btn btn-g" id="eSingle">Agregar</button>
          </div>
        </div>
        <div class="card">
          <h3>Ingreso masivo</h3>
          <div class="bw"><table class="bt">
            <thead><tr><th>Producto</th><th>Color</th><th>Talla</th><th>Cant.</th><th></th></tr></thead>
            <tbody id="eBulkBody"><tr id="eBE"><td colspan="5" style="color:#888;text-align:center;padding:.6rem;font-size:.75rem">Sin filas</td></tr></tbody>
          </table></div>
          <div class="bf">
            <button class="btn btn-o" id="addER">+ Fila</button>
            <button class="btn btn-g" id="eBulk">Aplicar ingresos</button>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<div class="toast" id="toast"></div>

<script is:inline define:vars={{sbUrl: import.meta.env.PUBLIC_SUPABASE_URL, sbAnon: import.meta.env.PUBLIC_SUPABASE_ANON_KEY}}>
(function(){
const LOW=5;
const sb=window.supabase.createClient(sbUrl,sbAnon);
const $=id=>document.getElementById(id);

function ld(on){$('ov').style.display=on?'flex':'none';}
function toast(m,ok=true){
  const t=$('toast');t.textContent=m;t.className='toast show '+(ok?'ok':'err');
  clearTimeout(t._t);t._t=setTimeout(()=>t.className='toast',3000);
}
function scls(s){return s<=0?'s0':s<LOW?'slow':'sok';}

// AUTH
async function init(){const{data:{session}}=await sb.auth.getSession();if(session)go(session.user.email);}
$('lbtn').addEventListener('click',async()=>{
  const em=$('lem').value.trim(),pw=$('lpw').value;
  if(!em||!pw){se('Completa los campos');return;}
  $('lbtn').disabled=true;
  const{data,error}=await sb.auth.signInWithPassword({email:em,password:pw});
  if(error){se(error.message||'Email o contrasena incorrectos');$('lbtn').disabled=false;return;}
  go(data.user.email);
});
$('lpw').addEventListener('keydown',e=>{if(e.key==='Enter')$('lbtn').click();});
$('logoutBtn').addEventListener('click',async()=>{await sb.auth.signOut();$('lw').style.display='flex';$('invP').style.display='none';allD=null;});
function se(m){const e=$('lerr');e.textContent=m;e.style.display='block';}
async function go(email){$('lw').style.display='none';$('invP').style.display='flex';$('uem').textContent=email;await load();}

// TABS
document.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.sec').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    $('tab-'+t.dataset.tab).classList.add('active');
  });
});

// DATA
let allD=null;
async function fetchAll(tbl,sel){
  let r=[],off=0;
  while(true){const{data}=await sb.from(tbl).select(sel).range(off,off+999);if(!data?.length)break;r.push(...data);if(data.length<1000)break;off+=1000;}
  return r;
}

async function load(){
  ld(true);
  try{
    const[products,variants]=await Promise.all([
      fetchAll('products','id,name,brands(name)'),
      fetchAll('product_variants','id,product_id,color,size,stock,active'),
    ]);
    const pm={};for(const p of products)pm[p.id]=p;
    const byP={};
    for(const v of variants){
      if(!v.active)continue;
      if(!byP[v.product_id])byP[v.product_id]={};
      if(!byP[v.product_id][v.color])byP[v.product_id][v.color]=[];
      byP[v.product_id][v.color].push(v);
    }
    for(const pid in byP)for(const c in byP[pid])byP[pid][c].sort((a,b)=>{const na=parseFloat(a.size),nb=parseFloat(b.size);return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);});
    allD={products,variants,pm,byP};

    // brands filter
    const brands=[...new Set(products.map(p=>p.brands?.name).filter(Boolean))].sort();
    brands.forEach(b=>{const o=document.createElement('option');o.value=b;o.textContent=b;$('fbr').appendChild(o);});

    // product selects — sorted brand+name
    const sp=[...products].sort((a,b)=>{const ba=a.brands?.name||'',bb=b.brands?.name||'';return ba.localeCompare(bb)||a.name.localeCompare(b.name);});
    setupPS('sCInp','sCDd','sCol','sSz','sCS',sp);
    setupPS('eCInp','eCDd','eCol','eSz','eCS',sp);

    render();
  }finally{ld(false);}
}

// RENDER — flat table, one row per size
function render(){
  if(!allD)return;
  const q=$('sq').value.toLowerCase().trim();
  const fs=$('fst').value;
  const fb=$('fbr').value;
  const{products,byP}=allD;

  const rows=[];
  for(const p of products){
    const brand=p.brands?.name||'';
    if(fb&&brand!==fb)continue;
    const cm=byP[p.id]||{};
    for(const[color,vs]of Object.entries(cm)){
      for(const v of vs){
        const s=v.stock||0;
        const lbl=(brand+' '+p.name+' '+color+' '+v.size).toLowerCase();
        if(q&&!lbl.includes(q))continue;
        if(fs==='0'&&s!==0)continue;
        if(fs==='low'&&(s<=0||s>=LOW))continue;
        if(fs==='ok'&&s<LOW)continue;
        rows.push({brand,name:p.name,color,size:v.size,stock:s,vid:v.id});
      }
    }
  }

  rows.sort((a,b)=>{
    if(a.name!==b.name)return a.name.localeCompare(b.name);
    if(a.color!==b.color)return a.color.localeCompare(b.color);
    const na=parseFloat(a.size),nb=parseFloat(b.size);
    return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);
  });

  if(!rows.length){
    $('tb').innerHTML='<tr><td colspan="5" style="text-align:center;padding:2rem;color:#888">Sin resultados</td></tr>';
    $('cnt').textContent='';$('sb').innerHTML='';return;
  }

  let n0=0,nL=0,nOk=0,tot=0;
  $('tb').innerHTML=rows.map(r=>{
    const s=r.stock;
    if(s===0)n0++;else if(s<LOW)nL++;else nOk++;
    tot+=s;
    return`<tr>
      <td>${r.brand}</td>
      <td>${r.name}</td>
      <td>${r.color}</td>
      <td style="text-align:center">${r.size}</td>
      <td class="${scls(s)}">${s}</td>
    </tr>`;
  }).join('');

  $('cnt').textContent=`${rows.length} filas`;
  $('sb').innerHTML=
    `<span class="chip" style="background:#FECACA;color:#991B1B">Sin stock: ${n0}</span>`+
    `<span class="chip" style="background:#FEF08A;color:#713F12">Stock bajo: ${nL}</span>`+
    `<span class="chip" style="background:#BBF7D0;color:#14532D">Stock OK: ${nOk}</span>`+
    `<span class="chip" style="background:#e0e0e0">Total unidades: ${tot}</span>`;
}

['sq','fst','fbr'].forEach(id=>$(id).addEventListener('input',render));

// EXCEL
$('exBtn').addEventListener('click',async()=>{
  if(!allD){toast('Sin datos',false);return;}
  ld(true);
  try{
    const{products,byP}=allD;
    const wb=new ExcelJS.Workbook();
    const ws=wb.addWorksheet('Inventario');
    ws.columns=[
      {header:'Marca',key:'brand',width:16},{header:'Producto',key:'name',width:22},
      {header:'Color',key:'color',width:20},{header:'Talla',key:'size',width:8},{header:'Stock',key:'stock',width:9},
    ];
    ws.getRow(1).eachCell(c=>{c.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FF000000'}};c.font={color:{argb:'FFFFFFFF'},bold:true};});

    const sp=[...products].sort((a,b)=>{
      const ba=a.brands?.name||'',bb=b.brands?.name||'';
      if(a.name!==b.name)return a.name.localeCompare(b.name);
      return ba.localeCompare(bb);
    });
    for(const p of sp){
      for(const[color,vs]of Object.entries(byP[p.id]||{})){
        for(const v of vs){
          const s=v.stock||0;
          const row=ws.addRow({brand:p.brands?.name||'',name:p.name,color,size:v.size,stock:s});
          const sc=row.getCell('stock');
          if(s===0){sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFFECACA'}};sc.font={color:{argb:'FF991B1B'},bold:true};}
          else if(s<LOW){sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFFEF08A'}};sc.font={color:{argb:'FF713F12'},bold:true};}
          else{sc.fill={type:'pattern',pattern:'solid',fgColor:{argb:'FFBBF7D0'}};sc.font={color:{argb:'FF14532D'},bold:true};}
        }
      }
    }
    const buf=await wb.xlsx.writeBuffer();
    const blob=new Blob([buf],{type:'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;
    a.download=`inventario-${new Date().toISOString().slice(0,10)}.xlsx`;
    document.body.appendChild(a);
    a.click();
    setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(url);},200);
    toast('Excel descargado');
  }catch(e){toast('Error al generar Excel',false);console.error(e);}
  finally{ld(false);}
});

// UPDATE STOCK
async function updS(vid,delta){
  const v=allD.variants.find(x=>x.id===vid);
  if(!v)throw new Error('No encontrado');
  const ns=Math.max(0,(v.stock||0)+delta);
  const{error}=await sb.from('product_variants').update({stock:ns}).eq('id',vid);
  if(error)throw error;
  v.stock=ns;return ns;
}

// COMBOBOX — integrates search + list into one widget
function setupPS(cInpId,cDdId,colId,szId,csId,sortedP){
  const inp=$(cInpId),dd=$(cDdId);
  const opts=sortedP.map(p=>({id:p.id,label:(p.brands?.name?p.brands.name+' ':'')+p.name}));
  let selPid=null;

  function renderOpts(q){
    const filtered=q?opts.filter(o=>o.label.toLowerCase().includes(q.toLowerCase())):opts;
    if(!filtered.length){
      dd.innerHTML='<div class="combo-none">Sin resultados</div>';
    }else{
      dd.innerHTML=filtered.map(o=>`<div class="combo-opt" data-id="${o.id}">${o.label}</div>`).join('');
      dd.querySelectorAll('.combo-opt').forEach(el=>{
        el.addEventListener('mousedown',e=>{
          e.preventDefault();
          selPid=el.dataset.id;
          inp.value=el.textContent;
          dd.classList.remove('open');
          onPick(selPid);
        });
      });
    }
  }

  function onPick(pid){
    $(colId).innerHTML='<option value="">Color...</option>';
    $(szId).innerHTML='<option value="">—</option>';
    $(colId).disabled=!pid;$(szId).disabled=true;$(csId).textContent='';
    if(!pid||!allD)return;
    Object.keys(allD.byP[pid]||{}).sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;$(colId).appendChild(o);});
  }

  inp.addEventListener('focus',()=>{renderOpts(inp.value);dd.classList.add('open');});
  inp.addEventListener('input',()=>{selPid=null;onPick(null);renderOpts(inp.value);dd.classList.add('open');});
  inp.addEventListener('blur',()=>setTimeout(()=>dd.classList.remove('open'),160));

  $(colId).addEventListener('change',()=>{
    const col=$(colId).value;
    $(szId).innerHTML='<option value="">Talla...</option>';
    $(szId).disabled=!col;$(csId).textContent='';
    if(!selPid||!col||!allD)return;
    (allD.byP[selPid]?.[col]||[]).forEach(v=>{
      const o=document.createElement('option');o.value=v.id;
      o.textContent=`${v.size} (${v.stock||0} disponibles)`;
      $(szId).appendChild(o);
    });
  });
  $(szId).addEventListener('change',()=>{
    const vid=$(szId).value;if(!vid||!allD){$(csId).textContent='';return;}
    const v=allD.variants.find(x=>x.id===vid);
    $(csId).textContent=v?`Stock actual: ${v.stock||0} unidades`:'';
  });

  renderOpts('');
}

// SINGLE OPS
async function singleOp(szId,csId,qtyId,delta,successMsg){
  const vid=$(szId).value,qty=parseInt($(qtyId).value)||0;
  if(!vid){toast('Selecciona producto / color / talla',false);return;}
  if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
  ld(true);
  try{
    const ns=await updS(vid,delta*qty);
    toast(`${successMsg} — stock: ${ns}u`);
    $(csId).textContent=`Stock actual: ${ns} unidades`;
    const v=allD.variants.find(x=>x.id===vid);
    const sel=$(szId);
    if(sel.selectedOptions[0]&&v)sel.selectedOptions[0].textContent=`${v.size} (${ns} disponibles)`;
    render();
  }catch(e){toast('Error: '+e.message,false);}
  finally{ld(false);}
}

$('sSingle').addEventListener('click',()=>singleOp('sSz','sCS','sQty',-1,'Descontado'));
$('eSingle').addEventListener('click',()=>singleOp('eSz','eCS','eQty',1,'Ingreso registrado'));

// BULK ROW
function addBR(tbodyId,emptyId){
  if(!allD){toast('Carga los datos primero',false);return;}
  $(emptyId).style.display='none';
  const tbody=$(tbodyId);
  const tr=document.createElement('tr');tr.dataset.bulk='1';tr._vid=null;

  // Product combobox
  const pWrap=document.createElement('div');pWrap.className='bcomb';
  const pInp=document.createElement('input');pInp.type='text';pInp.className='bcomb-inp';pInp.placeholder='Buscar...';pInp.autocomplete='off';
  const pDd=document.createElement('div');pDd.className='bcomb-dd';
  pWrap.append(pInp,pDd);

  const sortedP=[...allD.products].sort((a,b)=>{const ba=a.brands?.name||'',bb=b.brands?.name||'';return ba.localeCompare(bb)||a.name.localeCompare(b.name);});
  const opts=sortedP.map(p=>({id:p.id,label:(p.brands?.name?p.brands.name+' ':'')+p.name}));
  let selPid=null;

  function mkSel(placeholder){
    const s=document.createElement('select');
    s.innerHTML=`<option value="">${placeholder}</option>`;
    return s;
  }
  const cSel=mkSel('Color...'); cSel.disabled=true;
  const sSel=mkSel('Talla...'); sSel.disabled=true;

  function renderPOpts(q){
    const filtered=q?opts.filter(o=>o.label.toLowerCase().includes(q.toLowerCase())):opts;
    pDd.innerHTML=filtered.length
      ? filtered.map(o=>`<div class="bcomb-opt" data-id="${o.id}">${o.label}</div>`).join('')
      : '<div class="bcomb-opt" style="color:#999">Sin resultados</div>';
    pDd.querySelectorAll('.bcomb-opt[data-id]').forEach(el=>{
      el.addEventListener('mousedown',e=>{
        e.preventDefault();
        selPid=el.dataset.id;pInp.value=el.textContent;pDd.classList.remove('open');
        cSel.innerHTML='<option value="">Color...</option>';sSel.innerHTML='<option value="">Talla...</option>';
        cSel.disabled=!selPid;sSel.disabled=true;tr._vid=null;
        if(selPid)Object.keys(allD.byP[selPid]||{}).sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;cSel.appendChild(o);});
      });
    });
  }

  function openPDd(){
    const r=pInp.getBoundingClientRect();
    pDd.style.top=(r.bottom+window.scrollY)+'px';
    pDd.style.left=(r.left+window.scrollX)+'px';
    pDd.style.width=r.width+'px';
    pDd.classList.add('open');
  }
  pInp.addEventListener('focus',()=>{renderPOpts(pInp.value);openPDd();});
  pInp.addEventListener('input',()=>{selPid=null;cSel.innerHTML='<option value="">Color...</option>';sSel.innerHTML='<option value="">Talla...</option>';cSel.disabled=true;sSel.disabled=true;tr._vid=null;renderPOpts(pInp.value);openPDd();});
  pInp.addEventListener('blur',()=>setTimeout(()=>pDd.classList.remove('open'),160));
  renderPOpts('');

  cSel.addEventListener('change',()=>{
    const col=cSel.value;
    sSel.innerHTML='<option value="">Talla...</option>';sSel.disabled=!col;tr._vid=null;
    if(!selPid||!col)return;
    (allD.byP[selPid]?.[col]||[]).forEach(v=>{
      const o=document.createElement('option');o.value=v.id;
      o.textContent=`${v.size} (${v.stock||0} disponibles)`;
      sSel.appendChild(o);
    });
  });
  sSel.addEventListener('change',()=>{tr._vid=sSel.value||null;});

  const qi=document.createElement('input');qi.type='number';qi.min='1';qi.value='1';

  const rb=document.createElement('button');rb.className='rm';rb.textContent='x';
  rb.addEventListener('click',()=>{tr.remove();if(!tbody.querySelectorAll('[data-bulk]').length)$(emptyId).style.display='';});

  function cell(el){const td=document.createElement('td');td.appendChild(el);return td;}
  tr.append(cell(pWrap),cell(cSel),cell(sSel),cell(qi),cell(rb));
  tbody.appendChild(tr);
}

$('addSR').addEventListener('click',()=>addBR('sBulkBody','sBE'));
$('addER').addEventListener('click',()=>addBR('eBulkBody','eBE'));

async function applyBulk(tbodyId,emptyId,delta){
  const rows=[...$(tbodyId).querySelectorAll('[data-bulk]')];
  if(!rows.length){toast('No hay filas',false);return;}
  const ops=rows.map(tr=>({vid:tr._vid,qty:parseInt(tr.querySelector('input[type=number]').value)||0})).filter(o=>o.vid&&o.qty>0);
  if(!ops.length){toast('Completa las filas',false);return;}
  ld(true);
  try{
    for(const o of ops)await updS(o.vid,delta*o.qty);
    toast(`${ops.length} variantes actualizadas`);
    $(tbodyId).querySelectorAll('[data-bulk]').forEach(r=>r.remove());
    $(emptyId).style.display='';
    render();
  }catch(e){toast('Error: '+e.message,false);}
  finally{ld(false);}
}

$('sBulk').addEventListener('click',()=>applyBulk('sBulkBody','sBE',-1));
$('eBulk').addEventListener('click',()=>applyBulk('eBulkBody','eBE',1));

init();
})();
</script>
</body>
</html>
