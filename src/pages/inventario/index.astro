<script is:inline define:vars={{sbUrl: import.meta.env.PUBLIC_SUPABASE_URL, sbAnon: import.meta.env.PUBLIC_SUPABASE_ANON_KEY}}>
(function(){
const LOW=5;
const sb=window.supabase.createClient(sbUrl,sbAnon);
const $=id=>document.getElementById(id);

function ld(on){$('ov').style.display=on?'flex':'none';}
function toast(m,ok=true){
  const t=$('toast');t.textContent=m;t.className='toast show '+(ok?'ok':'err');
  clearTimeout(t._t);t._t=setTimeout(()=>t.className='toast',3000);
}
function scls(s){return s<=0?'s0':s<LOW?'slow':'sok';}

// AUTH
$('eyeBtn').addEventListener('click',()=>{
  const pw=$('lpw');const show=pw.type==='password';
  pw.type=show?'text':'password';
  $('eyeIcon').innerHTML=show
    ?'<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/>'
    :'<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
  $('eyeBtn').style.color=show?'#555':'#aaa';
});
window.__tsToken=null;
window.onTurnstileSuccess=function(t){
  window.__tsToken=t;
  const lerr=$('lerr');if(lerr)lerr.style.display='none';
  const em=$('lem').value.trim(),pw=$('lpw').value;
  if(em&&pw)$('lbtn').click();
};

async function init(){const{data:{session}}=await sb.auth.getSession();if(session)go(session.user.email);}
$('lbtn').addEventListener('click',async()=>{
  const em=$('lem').value.trim(),pw=$('lpw').value;
  if(!em||!pw){se('Completa los campos');return;}
  if(!window.__tsToken){se('Completa la verificacion de seguridad');return;}
  $('lbtn').disabled=true;
  const{data,error}=await sb.auth.signInWithPassword({email:em,password:pw,options:{captchaToken:window.__tsToken}});
  if(error){
    se(error.message||'Email o contrasena incorrectos');
    if(window.turnstile)window.turnstile.reset();
    window.__tsToken=null;
    $('lbtn').disabled=false;return;
  }
  go(data.user.email);
});
$('lpw').addEventListener('keydown',e=>{if(e.key==='Enter')$('lbtn').click();});
$('logoutBtn').addEventListener('click',async()=>{await sb.auth.signOut();$('lw').style.display='flex';$('invP').style.display='none';allD=null;});
function se(m){const e=$('lerr');e.textContent=m;e.style.display='block';}
async function go(email){currentUserEmail=email;$('lw').style.display='none';$('invP').style.display='flex';$('uem').textContent=email;await load();}

// TABS
document.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.sec').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    $('tab-'+t.dataset.tab).classList.add('active');
  });
});

// DATA
let allD=null;
let _vzReady=false;
async function fetchAll(tbl,sel){
  let r=[],off=0;
  while(true){const{data}=await sb.from(tbl).select(sel).range(off,off+999);if(!data?.length)break;r.push(...data);if(data.length<1000)break;off+=1000;}
  return r;
}

async function reloadStock(){
  try{
    const variants=await fetchAll('product_variants','id,product_id,color,size,stock_almacen,stock_bodega,active');
    if(!allD)return;
    allD.variants=variants;
    const byP={};
    for(const v of variants){
      if(!v.active)continue;
      if(!byP[v.product_id])byP[v.product_id]={};
      if(!byP[v.product_id][v.color])byP[v.product_id][v.color]=[];
      byP[v.product_id][v.color].push(v);
    }
    for(const pid in byP)for(const c in byP[pid])byP[pid][c].sort((a,b)=>{const na=parseFloat(a.size),nb=parseFloat(b.size);return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);});
    allD.byP=byP;
    render();
  }catch(e){toast('Error actualizando stock: '+e.message,false);}
}

async function load(){
  ld(true);
  try{
    const[products,variants]=await Promise.all([
      fetchAll('products','id,name,brands(name)'),
      fetchAll('product_variants','id,product_id,color,size,stock_almacen,stock_bodega,active'),
    ]);
    const pm={};for(const p of products)pm[p.id]=p;
    const byP={};
    for(const v of variants){
      if(!v.active)continue;
      if(!byP[v.product_id])byP[v.product_id]={};
      if(!byP[v.product_id][v.color])byP[v.product_id][v.color]=[];
      byP[v.product_id][v.color].push(v);
    }
    for(const pid in byP)for(const c in byP[pid])byP[pid][c].sort((a,b)=>{const na=parseFloat(a.size),nb=parseFloat(b.size);return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);});
    allD={products,variants,pm,byP};

    const brands=[...new Set(products.map(p=>p.brands?.name).filter(Boolean))].sort();
    $('fbr').innerHTML='<option value="">Todas las marcas</option>';
    brands.forEach(b=>{const o=document.createElement('option');o.value=b;o.textContent=b;$('fbr').appendChild(o);});

    const sp=[...products].sort((a,b)=>{const ba=a.brands?.name||'',bb=b.brands?.name||'';return ba.localeCompare(bb)||a.name.localeCompare(b.name);});
    setupPS('sCInp','sCDd','sCol','sSz','sCS',sp);
    setupPS('eCInp','eCDd','eCol','eSz','eCS',sp);
    if(!_vzReady){_vzReady=true;setupVelozAll(sp);setupLoans(sp);}

    render();
  }finally{ld(false);}
}

// RENDER — one row per variant with stock procalzado
function render(){
  if(!allD)return;
  const q=$('sq').value.toLowerCase().trim();
  const fs=$('fst').value;
  const fb=$('fbr').value;
  const{products,byP}=allD;

  const rows=[];
  for(const p of products){
    const brand=p.brands?.name||'';
    if(fb&&brand!==fb)continue;
    const cm=byP[p.id]||{};
    for(const[color,vs]of Object.entries(cm)){
      for(const v of vs){
        const tot=v.stock_almacen||0;
        const lbl=(brand+' '+p.name+' '+color+' '+v.size).toLowerCase();
        if(q&&!lbl.includes(q))continue;
        if(fs==='0'&&tot!==0)continue;
        if(fs==='low'&&(tot<=0||tot>=LOW))continue;
        if(fs==='ok'&&tot<LOW)continue;
        rows.push({brand,name:p.name,color,size:v.size,tot,vid:v.id});
      }
    }
  }

  rows.sort((a,b)=>{
    if(a.name!==b.name)return a.name.localeCompare(b.name);
    if(a.color!==b.color)return a.color.localeCompare(b.color);
    const na=parseFloat(a.size),nb=parseFloat(b.size);
    return(!isNaN(na)&&!isNaN(nb))?na-nb:a.size.localeCompare(b.size);
  });

  if(!rows.length){
    $('tb').innerHTML='<tr><td colspan="5" style="text-align:center;padding:2rem;color:#888">Sin resultados</td></tr>';
    $('cnt').textContent='';$('sb').innerHTML='';return;
  }

  let n0=0,nL=0,nOk=0;
  $('tb').innerHTML=rows.map(r=>{
    if(r.tot===0)n0++;else if(r.tot<LOW)nL++;else nOk++;
    return`<tr>
      <td>${r.brand}</td>
      <td>${r.name}</td>
      <td>${r.color}</td>
      <td style="text-align:center">${r.size}</td>
      <td class="num ${scls(r.tot)}">${r.tot}</td>
    </tr>`;
  }).join('');

  $('cnt').textContent=`${rows.length} filas`;
  $('sb').innerHTML=
    `<span class="chip" style="background:#FECACA;color:#991B1B">Sin stock: ${n0}</span>`+
    `<span class="chip" style="background:#FEF08A;color:#713F12">Stock bajo: ${nL}</span>`+
    `<span class="chip" style="background:#BBF7D0;color:#14532D">Stock OK: ${nOk}</span>`+
    `<span class="chip" style="background:#e0e0e0">Total: ${rows.reduce((s,r)=>s+r.tot,0)}</span>`;
}

['sq','fst','fbr'].forEach(id=>$(id).addEventListener('input',render));
$('reloadBtn').addEventListener('click',()=>load());

// EXCEL
$('exBtn').addEventListener('click',()=>{
  if(!allD){toast('Sin datos',false);return;}
  const{products,byP}=allD;
  const sp=[...products].sort((a,b)=>{
    if(a.name!==b.name)return a.name.localeCompare(b.name);
    return(a.brands?.name||'').localeCompare(b.brands?.name||'');
  });
  let filas='';
  for(const p of sp){
    for(const[color,vs]of Object.entries(byP[p.id]||{})){
      for(const v of vs){
        const tot=v.stock_almacen||0;
        let bg,fg;
        if(tot<=0){bg='#FECACA';fg='#991B1B';}
        else if(tot<LOW){bg='#FEF08A';fg='#713F12';}
        else{bg='#BBF7D0';fg='#14532D';}
        filas+=`<tr><td>${p.brands?.name||''}</td><td>${p.name}</td><td>${color}</td><td>${v.size}</td><td style="background:${bg};color:${fg};font-weight:bold">${tot}</td></tr>`;
      }
    }
  }
  const html=`<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8"><style>th{background:#000;color:#fff;font-weight:bold;padding:4px 8px;border:1px solid #444}td{padding:3px 8px;border:1px solid #ccc}</style></head><body><table><thead><tr><th>Marca</th><th>Producto</th><th>Color</th><th>Talla</th><th>Stock Procalzado</th></tr></thead><tbody>${filas}</tbody></table></body></html>`;
  const blob=new Blob(['﻿'+html],{type:'application/vnd.ms-excel;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a');
  a.href=url;a.download=`inventario-${new Date().toISOString().slice(0,10)}.xls`;
  document.body.appendChild(a);a.click();
  setTimeout(()=>{document.body.removeChild(a);URL.revokeObjectURL(url);},200);
  toast('Excel descargado');
});

// API MUTATE — todas las escrituras van por el endpoint server-side (service role key, bypass RLS)
let currentUserEmail = '';
async function apiMutate(body){
  const{data:{session}}=await sb.auth.getSession();
  const token=session?.access_token||'';
  const res=await fetch('/api/inventory/mutate',{
    method:'POST',
    headers:{'Content-Type':'application/json','Authorization':'Bearer '+token},
    body:JSON.stringify(body),
  });
  const json=await res.json();
  if(!res.ok)throw new Error(json.error||'Error del servidor');
  return json;
}

async function logMovement(type,vid,qty){
  try{
    const v=allD?.variants.find(x=>x.id===vid);
    if(!v)return;
    const p=allD?.pm[v.product_id];
    await apiMutate({
      action:'log_movement',type,
      product_name:p?.name||'',brand_name:p?.brands?.name||'',
      color:v.color||'',size:v.size||'',quantity:qty,
      user_email:currentUserEmail,
      location:null,from_location:null,to_location:null,
    });
  }catch(_){}
}

// UPDATE STOCK
async function updS(vid,delta){
  const v=allD.variants.find(x=>x.id===vid);
  if(!v)throw new Error('No encontrado');
  const cur=v.stock_almacen||0;
  if(delta<0&&cur+delta<0)throw new Error(`Stock insuficiente: solo hay ${cur} unidades`);
  const ns=Math.max(0,cur+delta);
  const{data}=await apiMutate({action:'update_stock',vid,field:'stock_almacen',value:ns});
  v.stock_almacen=data.stock_almacen;
  return v.stock_almacen;
}

// COMBOBOX
function setupPS(cInpId,cDdId,colId,szId,csId,sortedP){
  const inp=$(cInpId),dd=$(cDdId);
  const opts=sortedP.map(p=>({id:p.id,label:(p.brands?.name?p.brands.name+' ':'')+p.name}));
  let selPid=null;

  function renderOpts(q){
    const filtered=q?opts.filter(o=>o.label.toLowerCase().includes(q.toLowerCase())):opts;
    if(!filtered.length){
      dd.innerHTML='<div class="combo-none">Sin resultados</div>';
    }else{
      dd.innerHTML=filtered.map(o=>`<div class="combo-opt" data-id="${o.id}">${o.label}</div>`).join('');
      dd.querySelectorAll('.combo-opt').forEach(el=>{
        el.addEventListener('pointerdown',e=>{
          e.preventDefault();
          selPid=el.dataset.id;
          inp.value=el.textContent;
          dd.classList.remove('open');
          onPick(selPid);
        });
      });
    }
  }

  function onPick(pid){
    $(colId).innerHTML='<option value="">Color...</option>';
    $(szId).innerHTML='<option value="">—</option>';
    $(colId).disabled=!pid;$(szId).disabled=true;$(csId).textContent='';
    if(!pid||!allD)return;
    Object.keys(allD.byP[pid]||{}).sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;$(colId).appendChild(o);});
  }

  inp.addEventListener('focus',()=>{renderOpts(inp.value);dd.classList.add('open');});
  inp.addEventListener('input',()=>{selPid=null;onPick(null);renderOpts(inp.value);dd.classList.add('open');});
  document.addEventListener('pointerdown',e=>{if(!inp.contains(e.target)&&!dd.contains(e.target))dd.classList.remove('open');},{passive:true});

  $(colId).addEventListener('change',()=>{
    const col=$(colId).value;
    $(szId).innerHTML='<option value="">Talla...</option>';
    $(szId).disabled=!col;$(csId).textContent='';
    if(!selPid||!col||!allD)return;
    (allD.byP[selPid]?.[col]||[]).forEach(v=>{
      const o=document.createElement('option');o.value=v.id;
      o.textContent=`${v.size} (Stock: ${v.stock_almacen||0})`;
      $(szId).appendChild(o);
    });
  });
  $(szId).addEventListener('change',()=>{
    const vid=$(szId).value;if(!vid||!allD){$(csId).textContent='';return;}
    const v=allD.variants.find(x=>x.id===vid);
    $(csId).textContent=v?`Stock Procalzado: ${v.stock_almacen||0} u`:'';
  });

  renderOpts('');
}

// SINGLE OPS
async function singleOp(szId,csId,qtyId,delta,successMsg,type){
  const vid=$(szId).value,qty=parseInt($(qtyId).value)||0;
  if(!vid){toast('Selecciona producto / color / talla',false);return;}
  if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
  ld(true);
  try{
    const ns=await updS(vid,delta*qty);
    const v=allD.variants.find(x=>x.id===vid);
    toast(`${successMsg} — Stock: ${ns}u`);
    if(v)$(csId).textContent=`Stock Procalzado: ${v.stock_almacen||0} u`;
    await logMovement(type,vid,qty);
    render();
  }catch(e){toast('Error: '+e.message,false);}
  finally{ld(false);}
}

function confirmMovement(title,detail){
  return new Promise(resolve=>{
    const ov=document.createElement('div');
    ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:flex;align-items:center;justify-content:center;padding:1rem';
    const box=document.createElement('div');
    box.style.cssText='background:#fff;border-radius:8px;padding:1.5rem;max-width:380px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,.25);font-family:inherit;border-top:4px solid #f00';
    box.innerHTML=`<p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.4rem">${title}</p>
<p style="font-size:.88rem;margin-bottom:1.1rem;line-height:1.5">¿Estás seguro de realizar este movimiento? Se afectará el inventario.<br><strong>${detail}</strong></p>
<div style="display:flex;gap:.5rem;justify-content:flex-end">
  <button class="btn btn-o" id="_cfNo">Cancelar</button>
  <button class="btn btn-r" id="_cfYes">Confirmar</button>
</div>`;
    ov.appendChild(box);document.body.appendChild(ov);
    box.querySelector('#_cfYes').addEventListener('click',()=>{ov.remove();resolve(true);});
    box.querySelector('#_cfNo').addEventListener('click',()=>{ov.remove();resolve(false);});
    ov.addEventListener('pointerdown',e=>{if(e.target===ov){ov.remove();resolve(false);}});
  });
}

$('sSingle').addEventListener('click',async()=>{
  const vid=$('sSz').value,qty=parseInt($('sQty').value)||0;
  if(!vid){toast('Selecciona producto / color / talla',false);return;}
  if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
  const v=allD?.variants.find(x=>x.id===vid);
  const detail=v?`${qty} par(es) — ${v.color} T${v.size}`:`${qty} par(es)`;
  const ok=await confirmMovement('Descontar venta',detail);
  if(!ok)return;
  await singleOp('sSz','sCS','sQty',-1,'Descontado','venta');
});

$('eSingle').addEventListener('click',async()=>{
  const vid=$('eSz').value,qty=parseInt($('eQty').value)||0;
  if(!vid){toast('Selecciona producto / color / talla',false);return;}
  if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
  const v=allD?.variants.find(x=>x.id===vid);
  const detail=v?`${qty} par(es) — ${v.color} T${v.size}`:`${qty} par(es)`;
  const ok=await confirmMovement('Ingreso de mercancía',detail);
  if(!ok)return;
  await singleOp('eSz','eCS','eQty',1,'Ingreso registrado','ingreso');
});

// DROPDOWN SINGLETON (usado por blocks masivos)
const _bDd=document.createElement('div');_bDd.id='_bDd';document.body.appendChild(_bDd);
let _bDdCtx=null;

function _bDdOpen(inp,opts,onSel){
  _bDdCtx={inp,opts,onSel};
  _bDdRender(inp.value);
  const r=inp.getBoundingClientRect();
  _bDd.style.cssText=`display:block;top:${r.bottom}px;left:${r.left}px;width:${r.width}px`;
}
function _bDdRender(q){
  if(!_bDdCtx)return;
  const{opts,onSel}=_bDdCtx;
  const fil=q?opts.filter(o=>o.label.toLowerCase().includes(q.toLowerCase())):opts;
  _bDd.innerHTML=fil.length
    ?fil.map(o=>`<div class="bcomb-opt" data-id="${o.id}">${o.label}</div>`).join('')
    :'<div class="bcomb-opt" style="color:#999;cursor:default">Sin resultados</div>';
  _bDd.querySelectorAll('.bcomb-opt[data-id]').forEach(el=>{
    el.addEventListener('pointerdown',e=>{
      e.preventDefault();
      onSel(el.dataset.id,el.textContent.trim());
      _bDd.style.display='none';_bDdCtx=null;
    });
  });
}
document.addEventListener('pointerdown',e=>{
  if(_bDdCtx&&!_bDdCtx.inp.contains(e.target)&&!_bDd.contains(e.target)){
    _bDd.style.display='none';_bDdCtx=null;
  }
},{passive:true});

// MULTI-BLOCK MASIVO
function addVzBlock(type){
  if(!allD){toast('Carga los datos primero',false);return;}
  const cfg={
    S:{containerId:'vzSBlocks',applyWrapId:'vzSApplyWrap',colHeader:'Cant. a descontar'},
    E:{containerId:'vzEBlocks',applyWrapId:'vzEApplyWrap',colHeader:'Cant. a ingresar'},
  }[type];
  const container=$(cfg.containerId),applyWrap=$(cfg.applyWrapId);

  const block=document.createElement('div');
  block.style.cssText='border:1px solid #ddd;border-radius:5px;padding:.85rem;background:#fafafa';

  const sortedP=[...allD.products].sort((a,b)=>{
    const ba=a.brands?.name||'',bb=b.brands?.name||'';
    return ba.localeCompare(bb)||a.name.localeCompare(b.name);
  });
  const opts=sortedP.map(p=>({id:p.id,label:(p.brands?.name?p.brands.name+' ':'')+p.name}));
  let selPid=null;

  const hdr=document.createElement('div');
  hdr.style.cssText='display:flex;gap:.5rem;align-items:flex-end;flex-wrap:wrap;margin-bottom:.6rem';

  const pWrap=document.createElement('div');
  pWrap.style.cssText='flex:1;min-width:160px';
  const pLabel=document.createElement('label');
  pLabel.style.cssText='display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.22rem';
  pLabel.textContent='Producto';
  const pComb=document.createElement('div');pComb.className='combo';
  const pInp=document.createElement('input');
  pInp.type='text';pInp.className='combo-inp';pInp.placeholder='Buscar producto...';pInp.autocomplete='off';
  const pDd=document.createElement('div');pDd.className='combo-dd';
  pComb.append(pInp,pDd);pWrap.append(pLabel,pComb);

  const colWrap=document.createElement('div');
  const colLabel=document.createElement('label');
  colLabel.style.cssText='display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.22rem';
  colLabel.textContent='Color';
  const colSel=document.createElement('select');
  colSel.className='loc-sel';colSel.disabled=true;
  colSel.innerHTML='<option value="">— producto primero —</option>';
  colWrap.append(colLabel,colSel);

  const rmBtn=document.createElement('button');
  rmBtn.type='button';rmBtn.className='btn btn-o';
  rmBtn.style.cssText='color:#dc2626;border-color:#dc2626;align-self:flex-end';
  rmBtn.textContent='✕ Quitar';
  rmBtn.addEventListener('click',()=>{block.remove();applyWrap.hidden=container.children.length===0;});

  hdr.append(pWrap,colWrap,rmBtn);

  const tblArea=document.createElement('div');tblArea.hidden=true;
  const bw=document.createElement('div');bw.className='bw';
  const tbl=document.createElement('table');tbl.className='bt';
  tbl.innerHTML=`<thead><tr><th style="width:70px">Talla</th><th class="num">Stock</th><th>${cfg.colHeader}</th></tr></thead>`;
  const tbody=document.createElement('tbody');
  tbl.appendChild(tbody);bw.appendChild(tbl);tblArea.appendChild(bw);

  function openDd(){
    _bDdOpen(pInp,opts,(id,label)=>{
      selPid=id;pInp.value=label;
      colSel.innerHTML='<option value="">Color...</option>';
      colSel.disabled=!id;tblArea.hidden=true;tbody.innerHTML='';
      if(id)Object.keys(allD.byP[id]||{}).sort().forEach(c=>{
        const o=document.createElement('option');o.value=c;o.textContent=c;colSel.appendChild(o);
      });
    });
  }
  pInp.addEventListener('focus',openDd);
  pInp.addEventListener('input',()=>{
    if(_bDdCtx&&_bDdCtx.inp===pInp)_bDdRender(pInp.value);
    else openDd();
    if(selPid){selPid=null;colSel.innerHTML='<option value="">Color...</option>';colSel.disabled=true;tblArea.hidden=true;tbody.innerHTML='';}
  });
  colSel.addEventListener('change',()=>{
    const col=colSel.value;
    if(!col||!selPid){tblArea.hidden=true;tbody.innerHTML='';return;}
    const vs=allD.byP[selPid]?.[col]||[];
    tbody.innerHTML=vs.map(v=>`<tr data-vid="${v.id}">
      <td style="font-weight:600;text-align:center;font-size:.9rem">${v.size}</td>
      <td class="num">${v.stock_almacen||0}</td>
      <td><input type="number" min="0" value="0" class="qi" style="width:64px"/></td>
    </tr>`).join('');
    tblArea.hidden=false;
  });

  block.append(hdr,tblArea);
  container.appendChild(block);
  applyWrap.hidden=false;
}

function getVzBlockOps(containerId){
  const ops=[];
  $(containerId).querySelectorAll('[data-vid]').forEach(tr=>{
    const qty=parseInt(tr.querySelector('input[type=number]').value)||0;
    if(qty>0)ops.push({vid:tr.dataset.vid,qty});
  });
  return ops;
}

function refreshVzBlocks(containerId){
  $(containerId).querySelectorAll('[data-vid]').forEach(tr=>{
    const v=allD.variants.find(x=>x.id===tr.dataset.vid);
    if(v){tr.cells[1].textContent=v.stock_almacen||0;tr.querySelector('input').value='0';}
  });
}

// HISTORIAL
let histData=[];
async function loadHistory(){
  ld(true);
  try{
    let all=[],offset=0;
    const limit=1000;
    while(true){
      const{data}=await apiMutate({action:'get_movements',offset,limit});
      if(!data||!data.length)break;
      all=all.concat(data);
      if(data.length<limit)break;
      offset+=limit;
    }
    histData=all;
    renderHistory();
  }catch(e){toast('Error cargando historial: '+e.message,false);}
  finally{ld(false);}
}

function renderHistory(){
  const q=$('hfsq').value.toLowerCase().trim();
  const ft=$('hftype').value;
  let rows=histData;
  if(ft)rows=rows.filter(r=>r.type===ft);
  if(q)rows=rows.filter(r=>(r.product_name||'').toLowerCase().includes(q)||(r.brand_name||'').toLowerCase().includes(q)||(r.color||'').toLowerCase().includes(q));

  if(!rows.length){
    $('htb').innerHTML='<tr><td colspan="8" style="text-align:center;padding:2rem;color:#888">Sin movimientos</td></tr>';
    $('hcnt').textContent='';return;
  }

  const fmt=dt=>{
    const d=new Date(dt);
    return d.toLocaleDateString('es-CO',{day:'2-digit',month:'2-digit',year:'numeric'})+
      ' '+d.toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit'});
  };

  const typeBadge=t=>`<span class="mv-${t}">${t}</span>`;

  $('htb').innerHTML=rows.map(r=>`<tr>
    <td style="white-space:nowrap">${fmt(r.created_at)}</td>
    <td>${typeBadge(r.type)}</td>
    <td>${r.brand_name||''}</td>
    <td>${r.product_name||''}</td>
    <td>${r.color||''}</td>
    <td style="text-align:center">${r.size||''}</td>
    <td class="num">${r.quantity}</td>
    <td style="font-size:.72rem;color:#666">${r.user_email||''}</td>
  </tr>`).join('');
  $('hcnt').textContent=`${rows.length} movimientos`;
}

['hftype','hfsq'].forEach(id=>$(id).addEventListener('input',renderHistory));
$('hReloadBtn').addEventListener('click',loadHistory);

// cargar historial / préstamos al entrar al tab
document.querySelectorAll('.tab').forEach(t=>{
  t.addEventListener('click',()=>{
    if(t.dataset.tab==='his'&&!histData.length)loadHistory();
    if(t.dataset.tab==='loan')loadLoans();
    if(t.dataset.tab==='ml'){loadMLStatus();loadMLVariants();}
  });
});

// MERCADOLIBRE
let mlVariantsData=[];

async function loadMLStatus(){
  const st=$('mlStatus');
  st.textContent='Verificando conexión...';
  try{
    const r=await apiMutate({action:'get_ml_status'});
    if(r.connected&&!r.expired){
      const expStr=r.expires_at?` — vence ${new Date(r.expires_at).toLocaleString('es-CO',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'})}`:'';
      st.innerHTML=`<span style="color:green">● Conectado</span> — Vendedor ID: <strong>${r.ml_user_id||'—'}</strong><span style="color:#888;font-size:.75rem">${expStr}</span>`;
      $('mlConnectBtn').style.display='none';
    } else if(r.connected&&r.expired){
      st.innerHTML=`<span style="color:#f00">● Token vencido</span> — Vuelve a conectar para restaurar la sincronización`;
      $('mlConnectBtn').style.display='';
    } else {
      st.innerHTML='<span style="color:#aaa">● No conectado</span> — Haz clic en "Conectar con MercadoLibre" para autorizar';
      $('mlConnectBtn').style.display='';
    }
  } catch(e){st.textContent='Error verificando estado: '+e.message;}
}

async function loadMLVariants(){
  try{
    const variants=await fetchAll('product_variants','id,product_id,color,size,stock_almacen,stock_bodega,active,ml_item_id,ml_variation_id');
    const products=await fetchAll('products','id,name');
    const prodMap={};
    for(const p of products)prodMap[p.id]=p.name;
    mlVariantsData=variants.filter(v=>v.active).map(v=>({
      ...v,
      productName:prodMap[v.product_id]||'—',
      totalStock:v.stock_almacen||0,
    }));
    // Summary chips
    const total=mlVariantsData.length;
    const linked=mlVariantsData.filter(v=>v.ml_item_id).length;
    const products_linked=new Set(mlVariantsData.filter(v=>v.ml_item_id).map(v=>v.product_id)).size;
    $('mlSummary').innerHTML=`
      <span class="chip" style="background:#dcfce7;color:#166534;border-color:#bbf7d0">✓ ${linked} variantes vinculadas</span>
      <span class="chip" style="background:#dbeafe;color:#1e40af;border-color:#bfdbfe">${products_linked} productos</span>
      <span class="chip" style="background:#fef9c3;color:#713f12;border-color:#fde68a">${total-linked} sin ML</span>
    `;
    renderMLTable();
  }catch(e){
    $('mlTb').innerHTML=`<tr><td colspan="7" style="text-align:center;padding:1rem;color:red">${e.message}</td></tr>`;
  }
}

function renderMLTable(){
  const q=($('mlSearch').value||'').toLowerCase();
  const showAll=$('mlShowAll').checked;
  let rows=mlVariantsData.filter(v=>{
    if(!showAll&&!v.ml_item_id)return false;
    if(q&&!v.productName.toLowerCase().includes(q)&&!v.color.toLowerCase().includes(q))return false;
    return true;
  });
  // Sort A-Z por producto, luego color, luego talla numérica
  rows.sort((a,b)=>{
    const np=a.productName.localeCompare(b.productName,'es');
    if(np!==0)return np;
    const nc=a.color.localeCompare(b.color,'es');
    if(nc!==0)return nc;
    return Number(a.size)-Number(b.size);
  });
  $('mlCnt').textContent=rows.length?`${rows.length} variante${rows.length!==1?'s':''}`:'' ;
  if(!rows.length){$('mlTb').innerHTML='<tr><td colspan="7" style="text-align:center;padding:2rem;color:#888">Sin resultados</td></tr>';return;}

  // Agrupar por producto con fila separadora
  let lastProd='';
  $('mlTb').innerHTML=rows.map(v=>{
    let groupRow='';
    if(v.productName!==lastProd){
      lastProd=v.productName;
      groupRow=`<tr><td colspan="7" style="background:#f5f5f5;padding:.3rem .75rem;font-size:.7rem;font-weight:700;letter-spacing:.07em;text-transform:uppercase;color:#555;border-bottom:1px solid #ddd">${v.productName}</td></tr>`;
    }
    const s=v.totalStock;
    const scls=s<=0?'s0':s<5?'slow':'sok';
    const mlTag=v.ml_item_id
      ?`<span style="font-family:monospace;font-size:.75rem;background:#f0f4ff;color:#1e40af;padding:.15rem .45rem;border-radius:3px;border:1px solid #c7d2fe">${v.ml_item_id}</span>`
      :`<span style="font-size:.72rem;color:#aaa;font-style:italic">— sin ML</span>`;
    const varTag=v.ml_variation_id
      ?`<span style="font-family:monospace;font-size:.72rem;background:#f5f0ff;color:#6b21a8;padding:.15rem .4rem;border-radius:3px;border:1px solid #e9d5ff">${v.ml_variation_id}</span>`
      :`<span style="color:#ccc;font-size:.72rem">—</span>`;
    return groupRow+`<tr data-vid="${v.id}">
      <td style="padding:.35rem .75rem;color:#888;font-size:.78rem;font-style:italic">${v.productName}</td>
      <td style="padding:.35rem .75rem">${v.color}</td>
      <td class="num" style="padding:.35rem .75rem">${v.size}</td>
      <td class="num ${scls}" style="padding:.35rem .75rem">${s}</td>
      <td style="padding:.35rem .75rem">
        <div style="display:flex;align-items:center;gap:.4rem">
          ${mlTag}
          <input type="text" class="ml-item-inp" value="${v.ml_item_id||''}" placeholder="MCO…" style="width:130px;padding:.22rem .4rem;font-size:.75rem;border:1px solid #ddd;border-radius:4px;font-family:monospace"/>
        </div>
      </td>
      <td style="padding:.35rem .75rem">
        <div style="display:flex;align-items:center;gap:.4rem">
          ${varTag}
          <input type="text" class="ml-var-inp" value="${v.ml_variation_id||''}" placeholder="Opcional" style="width:100px;padding:.22rem .4rem;font-size:.75rem;border:1px solid #ddd;border-radius:4px;font-family:monospace"/>
        </div>
      </td>
      <td style="padding:.35rem .75rem;white-space:nowrap">
        <div style="display:flex;gap:.25rem">
          <button class="btn btn-b ml-save-btn" style="padding:.2rem .55rem;font-size:.68rem">Guardar</button>
          <button class="btn btn-o ml-vars-btn" style="padding:.2rem .55rem;font-size:.68rem" title="Ver variaciones de ML">Vars</button>
        </div>
      </td>
    </tr>`;
  }).join('');

  $('mlTb').querySelectorAll('.ml-vars-btn').forEach(btn=>{
    btn.addEventListener('click',async()=>{
      const tr=btn.closest('tr');
      const mlItemId=tr.querySelector('.ml-item-inp').value.trim();
      if(!mlItemId){toast('Primero escribe el ID de publicación ML',false);return;}
      btn.disabled=true;btn.textContent='...';
      try{
        const r=await apiMutate({action:'get_ml_item',ml_item_id:mlItemId});
        const vars=(r.data?.variations||[]);
        if(!vars.length){alert('Esta publicación no tiene variaciones — deja "ID Variación ML" vacío.');return;}
        const lines=vars.map(v=>{
          const talla=v.attribute_combinations?.find(a=>a.id==='SIZE'||a.name==='Talla')?.value_name||'?';
          const color=v.attribute_combinations?.find(a=>a.id==='COLOR'||a.name==='Color')?.value_name||'';
          return `<tr><td style="padding:.3rem .6rem;font-family:monospace;user-select:all;cursor:text">${v.id}</td><td style="padding:.3rem .6rem">Talla ${talla}${color?' — '+color:''}</td><td style="padding:.3rem .6rem;color:#888">${v.available_quantity??'?'} u.</td></tr>`;
        }).join('');
        let mod=document.getElementById('mlVarsModal');
        if(!mod){mod=document.createElement('div');mod.id='mlVarsModal';mod.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:9999;display:flex;align-items:center;justify-content:center';document.body.appendChild(mod);}
        mod.innerHTML=`<div style="background:#fff;border-radius:8px;padding:1.5rem;max-width:560px;width:90%;max-height:80vh;overflow-y:auto">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
            <strong style="font-family:monospace;font-size:.85rem">${mlItemId}</strong>
            <button onclick="document.getElementById('mlVarsModal').remove()" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:#888">×</button>
          </div>
          <p style="font-size:.75rem;color:#888;margin-bottom:.8rem">Clic en un ID para seleccionarlo.</p>
          <table style="width:100%;border-collapse:collapse;font-size:.82rem">
            <thead><tr style="background:#000;color:#fff"><th style="padding:.35rem .6rem;text-align:left;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase">ID Variación</th><th style="padding:.35rem .6rem;text-align:left;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase">Descripción</th><th style="padding:.35rem .6rem;text-align:left;font-size:.68rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase">Stock ML</th></tr></thead>
            <tbody>${lines}</tbody>
          </table>
        </div>`;
        mod.querySelectorAll('td[style*="monospace"]').forEach(td=>{td.addEventListener('click',()=>{const sel=window.getSelection();const r=document.createRange();r.selectNodeContents(td);sel.removeAllRanges();sel.addRange(r);});});
      }catch(e){toast('Error: '+e.message,false);}
      finally{btn.textContent='Vars';btn.disabled=false;}
    });
  });

  $('mlTb').querySelectorAll('.ml-save-btn').forEach(btn=>{
    btn.addEventListener('click',async()=>{
      const tr=btn.closest('tr');
      const vid=tr.dataset.vid;
      const mlItemId=tr.querySelector('.ml-item-inp').value.trim();
      const mlVarId=tr.querySelector('.ml-var-inp').value.trim();
      btn.disabled=true;btn.textContent='...';
      try{
        await apiMutate({action:'set_ml_ids',variant_id:vid,ml_item_id:mlItemId,ml_variation_id:mlVarId});
        const v=mlVariantsData.find(x=>x.id===vid);
        if(v){v.ml_item_id=mlItemId||null;v.ml_variation_id=mlVarId||null;}
        renderMLTable();
        toast('Guardado ✓');
      }catch(e){
        toast('Error: '+e.message,false);
        btn.textContent='Guardar';btn.disabled=false;
      }
    });
  });
}

$('mlSearch').addEventListener('input',renderMLTable);
$('mlShowAll').addEventListener('change',renderMLTable);
$('mlRefreshBtn').addEventListener('click',()=>{loadMLStatus();loadMLVariants();});

// PRÉSTAMOS
let loansData=[];

function setupLoans(sp){
  const opts=sp.map(p=>({id:p.id,label:(p.brands?.name?p.brands.name+' ':'')+p.name}));
  let selPid=null;

  function onPick(id,label){
    selPid=id;$('lnCInp').value=label;
    $('lnCol').innerHTML='<option value="">Color...</option>';
    $('lnCol').disabled=!id;
    $('lnSz').innerHTML='<option value="">—</option>';$('lnSz').disabled=true;$('lnCS').textContent='';
    if(id)Object.keys(allD.byP[id]||{}).sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;$('lnCol').appendChild(o);});
  }

  $('lnCInp').addEventListener('focus',()=>_bDdOpen($('lnCInp'),opts,onPick));
  $('lnCInp').addEventListener('input',()=>{
    if(_bDdCtx&&_bDdCtx.inp===$('lnCInp'))_bDdRender($('lnCInp').value);
    else _bDdOpen($('lnCInp'),opts,onPick);
    if(selPid){selPid=null;$('lnCol').innerHTML='<option value="">Color...</option>';$('lnCol').disabled=true;$('lnSz').innerHTML='<option value="">—</option>';$('lnSz').disabled=true;}
  });
  $('lnCol').addEventListener('change',()=>{
    const col=$('lnCol').value;
    $('lnSz').innerHTML='<option value="">—</option>';$('lnSz').disabled=!col;$('lnCS').textContent='';
    if(!selPid||!col)return;
    (allD.byP[selPid]?.[col]||[]).forEach(v=>{const o=document.createElement('option');o.value=v.id;o.textContent=`T${v.size} (Stock:${v.stock_almacen||0})`;$('lnSz').appendChild(o);});
  });
  $('lnSz').addEventListener('change',()=>{
    const v=allD?.variants.find(x=>x.id===$('lnSz').value);
    $('lnCS').textContent=v?`Stock Procalzado: ${v.stock_almacen||0} u`:'';
  });

  $('lnBtn').addEventListener('click',async()=>{
    const type=document.querySelector('input[name="lnType"]:checked').value;
    const person=$('lnPerson').value.trim();
    const vid=$('lnSz').value;
    const qty=parseInt($('lnQty').value)||0;
    const notes=$('lnNotes').value.trim();
    if(!person){toast('Indica la persona o empresa',false);return;}
    if(!vid){toast('Selecciona producto, color y talla',false);return;}
    if(qty<=0){toast('Cantidad debe ser mayor a 0',false);return;}
    const v=allD.variants.find(x=>x.id===vid);
    const p=allD.products.find(x=>x.id===selPid);
    const lab=type==='prestado'?'Prestamos a':'Nos presta';
    const ok=await confirmMovement('Registrar préstamo',`${lab} ${person}: ${qty} par(es) ${v?.color} T${v?.size}`);
    if(!ok)return;
    const{data:{session}}=await sb.auth.getSession();
    ld(true);
    try{
      await apiMutate({action:'create_loan',type,person_name:person,variant_id:vid,
        product_name:p?.name||'',brand_name:p?.brands?.name||'',
        color:v?.color||'',size:v?.size||'',quantity:qty,
        notes:notes||null,user_email:session?.user?.email||''});
      toast('Préstamo registrado');
      $('lnCInp').value='';selPid=null;$('lnPerson').value='';$('lnNotes').value='';$('lnQty').value='1';
      $('lnCol').innerHTML='<option value="">— primero producto —</option>';$('lnCol').disabled=true;
      $('lnSz').innerHTML='<option value="">—</option>';$('lnSz').disabled=true;$('lnCS').textContent='';
      await reloadStock();await loadLoans();
    }catch(e){toast('Error: '+e.message,false);}finally{ld(false);}
  });
}

async function loadLoans(){
  try{
    const{data}=await apiMutate({action:'get_loans'});
    loansData=data||[];renderLoans();
  }catch(e){toast('Error cargando préstamos: '+e.message,false);}
}

function renderLoans(){
  const pending=loansData.filter(l=>l.status==='pendiente');
  const resolved=loansData.filter(l=>l.status!=='pendiente');
  $('lnPendCnt').textContent=`${pending.length} pendiente${pending.length!==1?'s':''}`;
  $('lnHistCnt').textContent=`${resolved.length} resuelto${resolved.length!==1?'s':''}`;
  const fmt=dt=>new Date(dt).toLocaleDateString('es-CO',{day:'2-digit',month:'2-digit',year:'numeric'});
  $('lnPendTb').innerHTML=!pending.length
    ?'<tr><td colspan="8" style="text-align:center;padding:2rem;color:#888">Sin préstamos pendientes</td></tr>'
    :pending.map(l=>`<tr>
      <td style="white-space:nowrap">${fmt(l.created_at)}</td>
      <td><span class="ln-${l.type}">${l.type==='prestado'?'Prestamos':'Nos prestan'}</span></td>
      <td><strong>${l.person_name}</strong></td>
      <td>${l.brand_name?l.brand_name+' ':''}${l.product_name}</td>
      <td>${l.color} / T${l.size}</td>
      <td class="num">${l.quantity}</td>
      <td style="font-size:.75rem;color:#666">${l.notes||''}</td>
      <td><button class="btn btn-o" style="font-size:.7rem" onclick="openResolveLoan('${l.id}')">Resolver</button></td>
    </tr>`).join('');
  const rl={pagado:'Pagado',devuelto_mismo:'Devuelto (mismo)',devuelto_otra_talla:'Devuelto (otra talla)'};
  $('lnHistTb').innerHTML=!resolved.length
    ?'<tr><td colspan="8" style="text-align:center;padding:2rem;color:#888">Sin historial</td></tr>'
    :resolved.map(l=>`<tr>
      <td style="white-space:nowrap">${fmt(l.created_at)}</td>
      <td><span class="ln-${l.type}">${l.type==='prestado'?'Prestamos':'Nos prestan'}</span></td>
      <td>${l.person_name}</td>
      <td>${l.brand_name?l.brand_name+' ':''}${l.product_name}</td>
      <td>${l.color} / T${l.size}</td>
      <td class="num">${l.quantity}</td>
      <td><span class="ln-${l.status==='pagado'?'pagado':'devuelto'}">${rl[l.status]||l.status}</span></td>
      <td style="font-size:.75rem;color:#666">${l.notes||''}</td>
    </tr>`).join('');
}

window.openResolveLoan=function(loanId){
  const loan=loansData.find(l=>l.id===loanId);if(!loan)return;
  const isPrest=loan.type==='prestado';
  let otherVars=[];
  if(allD){
    for(const[,cm]of Object.entries(allD.byP)){
      for(const[col,vs]of Object.entries(cm)){
        if(col===loan.color&&vs.some(v=>v.id===loan.variant_id)){
          otherVars=vs.filter(v=>v.id!==loan.variant_id);break;
        }
      }
      if(otherVars.length)break;
    }
  }
  const ov=document.createElement('div');
  ov.style.cssText='position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;display:flex;align-items:center;justify-content:center;padding:1rem';
  const box=document.createElement('div');
  box.style.cssText='background:#fff;border-radius:8px;padding:1.5rem;max-width:440px;width:100%;box-shadow:0 8px 32px rgba(0,0,0,.25);font-family:inherit;border-top:4px solid #7c3aed';
  box.innerHTML=`
    <p style="font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.3rem">${isPrest?'Resolvemos préstamo a':'Devolvemos a'} ${loan.person_name}</p>
    <p style="font-size:.9rem;font-weight:600;margin-bottom:1rem">${loan.brand_name?loan.brand_name+' ':''}${loan.product_name} — ${loan.color} T${loan.size} × ${loan.quantity}</p>
    <div id="_lnOpts" style="display:flex;flex-direction:column;gap:.5rem;margin-bottom:.75rem">
      <button class="btn btn-g btn-w" data-res="pagado">${isPrest?'Nos pagaron':'Pagamos (lo compramos)'}</button>
      <button class="btn btn-b btn-w" data-res="devuelto_mismo">${isPrest?'Devolvieron el mismo par':'Devolvemos el mismo par'}</button>
      <button class="btn btn-p btn-w" data-res="devuelto_otra_talla">${isPrest?'Devolvieron otra talla':'Devolvemos otra talla'}</button>
    </div>
    <div id="_lnDevMismo" hidden style="margin-bottom:.75rem">
      <button class="btn btn-b btn-w" id="_lnConfMismo">Confirmar</button>
    </div>
    <div id="_lnOtraTalla" hidden style="margin-bottom:.75rem">
      <label style="display:block;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#666;margin-bottom:.35rem">Talla a ${isPrest?'recibir':'devolver'}</label>
      <select id="_lnOthVar" class="loc-sel" style="width:100%;margin-bottom:.5rem">
        <option value="">— seleccionar talla —</option>
        ${otherVars.map(v=>`<option value="${v.id}">T${v.size} (Stock:${v.stock_almacen||0})</option>`).join('')}
      </select>
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.5rem">
        <label style="font-size:.75rem;font-weight:600;color:#555;white-space:nowrap">Cantidad:</label>
        <input type="number" id="_lnOthQty" min="1" value="${loan.quantity}" class="qi" style="width:80px"/>
      </div>
      <button class="btn btn-p btn-w" id="_lnConfOtra">Confirmar</button>
    </div>
    <button class="btn btn-o btn-w" id="_lnCancel">Cancelar</button>`;
  ov.appendChild(box);document.body.appendChild(ov);
  box.querySelector('#_lnCancel').addEventListener('click',()=>ov.remove());
  ov.addEventListener('pointerdown',e=>{if(e.target===ov)ov.remove();});
  box.querySelectorAll('[data-res]').forEach(btn=>{
    btn.addEventListener('click',async()=>{
      const res=btn.dataset.res;
      if(res==='devuelto_mismo'){
        box.querySelector('#_lnOpts').hidden=true;
        box.querySelector('#_lnDevMismo').hidden=false;return;
      }
      if(res==='devuelto_otra_talla'){
        box.querySelector('#_lnOpts').hidden=true;
        box.querySelector('#_lnOtraTalla').hidden=false;return;
      }
      ov.remove();await doResolveLoan(loanId,res,null,null);
    });
  });
  box.querySelector('#_lnConfMismo').addEventListener('click',async()=>{
    ov.remove();await doResolveLoan(loanId,'devuelto_mismo',null,null);
  });
  box.querySelector('#_lnConfOtra').addEventListener('click',async()=>{
    const vid=box.querySelector('#_lnOthVar').value;
    const qty=parseInt(box.querySelector('#_lnOthQty').value)||loan.quantity;
    if(!vid){toast('Selecciona la talla',false);return;}
    ov.remove();await doResolveLoan(loanId,'devuelto_otra_talla',vid,qty);
  });
};

async function doResolveLoan(loanId,resolution,resolvedVid,resolvedQty){
  ld(true);
  try{
    await apiMutate({action:'resolve_loan',loan_id:loanId,resolution,resolved_variant_id:resolvedVid,resolved_quantity:resolvedQty});
    toast('Préstamo resuelto');await reloadStock();await loadLoans();
  }catch(e){toast('Error: '+e.message,false);}finally{ld(false);}
}

function setupVelozAll(sp){
  // VENTAS masivo
  $('vzSAddProd').addEventListener('click',()=>addVzBlock('S'));
  $('vzSApply').addEventListener('click',async()=>{
    const ops=getVzBlockOps('vzSBlocks');
    if(!ops.length){toast('Pon al menos una cantidad',false);return;}
    const ok=await confirmMovement('Descuento masivo',`${ops.length} variante${ops.length!==1?'s':''}`);
    if(!ok)return;
    ld(true);
    try{
      for(const o of ops){await updS(o.vid,-o.qty);await logMovement('venta',o.vid,o.qty);}
      toast(`${ops.length} variante${ops.length!==1?'s':''} descontadas`);
      refreshVzBlocks('vzSBlocks');render();
    }catch(e){toast('Error: '+e.message,false);}finally{ld(false);}
  });

  // INGRESOS masivo
  $('vzEAddProd').addEventListener('click',()=>addVzBlock('E'));
  $('vzEApply').addEventListener('click',async()=>{
    const ops=getVzBlockOps('vzEBlocks');
    if(!ops.length){toast('Pon al menos una cantidad',false);return;}
    const ok=await confirmMovement('Ingreso masivo',`${ops.length} variante${ops.length!==1?'s':''}`);
    if(!ok)return;
    ld(true);
    try{
      for(const o of ops){await updS(o.vid,o.qty);await logMovement('ingreso',o.vid,o.qty);}
      toast(`${ops.length} variante${ops.length!==1?'s':''} ingresadas`);
      refreshVzBlocks('vzEBlocks');render();
    }catch(e){toast('Error: '+e.message,false);}finally{ld(false);}
  });
}

init();
})();
</script>
</body>
</html>
