// BULK ROW
function addBulkRow(tbodyId,emptyId){
  if(!allData){toast('Carga los datos primero',false);return;}
  $(emptyId).style.display='none';
  const tbody=$(tbodyId);
  const tr=document.createElement('tr'); tr.dataset.bulk='1'; tr._vid=null;

  // Product select cell
  const tdP=document.createElement('td');
  const sSel=document.createElement('select'); sSel.className='';
  sSel.innerHTML='<option value="">Producto...</option>';
  allData.products.slice().sort((a,b)=>{
    const ba=a.brands?.name||'',bb=b.brands?.name||'';
    return ba.localeCompare(bb)||a.name.localeCompare(b.name);
  }).forEach(p=>{
    const o=document.createElement('option');o.value=p.id;
    o.textContent=(p.brands?.name?p.brands.name+' ':'')+p.name;
    sSel.appendChild(o);
  });
  tdP.appendChild(sSel);

  // Color select cell
  const tdC=document.createElement('td');
  const cSel=document.createElement('select'); cSel.disabled=true;
  cSel.innerHTML='<option value="">Color...</option>';
  tdC.appendChild(cSel);

  // Size select cell
  const tdSz=document.createElement('td');
  const szSel=document.createElement('select'); szSel.disabled=true;
  szSel.innerHTML='<option value="">Talla...</option>';
  tdSz.appendChild(szSel);

  sSel.addEventListener('change',()=>{
    const pid=sSel.value;
    cSel.innerHTML='<option value="">Color...</option>';
    szSel.innerHTML='<option value="">Talla...</option>';
    cSel.disabled=!pid; szSel.disabled=true; tr._vid=null;
    if(!pid) return;
    Object.keys(allData.byProd[pid]||{}).sort().forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;cSel.appendChild(o);});
  });
  cSel.addEventListener('change',()=>{
    const pid=sSel.value,color=cSel.value;
    szSel.innerHTML='<option value="">Talla...</option>';
    szSel.disabled=!color; tr._vid=null;
    if(!pid||!color) return;
    (allData.byProd[pid]?.[color]||[]).forEach(v=>{const o=document.createElement('option');o.value=v.id;o.textContent=`T${v.size} (${v.stock||0}u)`;szSel.appendChild(o);});
  });
  szSel.addEventListener('change',()=>{ tr._vid=szSel.value||null; });

  // Qty cell
  const tdQ=document.createElement('td');
  const qi=document.createElement('input'); qi.type='number'; qi.min='1'; qi.value='1';
  tdQ.appendChild(qi);

  // Remove cell
  const tdR=document.createElement('td');
  const rb=document.createElement('button'); rb.className='rm-btn'; rb.textContent='x';
  rb.addEventListener('click',()=>{
    tr.remove();
    if(!tbody.querySelectorAll('[data-bulk]').length) $(emptyId).style.display='';
  });
  tdR.appendChild(rb);

  tr.append(tdP,tdC,tdSz,tdQ,tdR);
  tbody.appendChild(tr);
}

$('addSaleRow').addEventListener('click',()=>addBulkRow('saleBulkBody','saleBulkEmpty'));
$('addEntryRow').addEventListener('click',()=>addBulkRow('entryBulkBody','entryBulkEmpty'));

async function applyBulk(tbodyId,emptyId,delta){
  const rows=[...$(tbodyId).querySelectorAll('[data-bulk]')];
  if(!rows.length){toast('No hay filas',false);return;}
  const ops=rows.map(tr=>({vid:tr._vid,qty:parseInt(tr.querySelector('input[type=number]').value)||0}))
    .filter(o=>o.vid&&o.qty>0);
  if(!ops.length){toast('Completa las filas',false);return;}
  loading(true);
  try{
    for(const o of ops) await updateStock(o.vid,delta*o.qty);
    toast(`${ops.length} variantes actualizadas`);
    $(tbodyId).querySelectorAll('[data-bulk]').forEach(r=>r.remove());
    $(emptyId).style.display='';
    renderTable();
  }catch(e){toast('Error: '+e.message,false);}
  finally{loading(false);}
}

$('saleBulkBtn').addEventListener('click',()=>applyBulk('saleBulkBody','saleBulkEmpty',-1));
$('entryBulkBtn').addEventListener('click',()=>applyBulk('entryBulkBody','entryBulkEmpty',1));

checkAuth();
})();
