---
import { getCatalogItems, getCategories } from '../lib/supabase';

const items = await getCatalogItems();
const allCats = await getCategories();

// Agrupar por categoría madre
const parentCats = allCats.filter(c => !c.parent_id);

// Para cada ítem, resolver su categoría madre
function getParentCatId(item: any): string | null {
  const p = item.products;
  if (!p) return null;
  // Buscar en product_categories
  const pc = p.product_categories?.find((pc: any) => pc.is_primary) || p.product_categories?.[0];
  const cat = pc?.categories || p.categories;
  if (!cat) return null;
  return cat.parent_id || cat.id; // si ya es madre, usar su id
}

// Grupos: { cat, items[] }
const groups: { cat: any; items: any[] }[] = parentCats.map(cat => {
  const children = allCats.filter(c => c.parent_id === cat.id).map(c => c.id);
  const groupItems = items.filter(it => {
    const pid = getParentCatId(it);
    return pid === cat.id || children.includes(pid || '');
  });
  return { cat, items: groupItems };
}).filter(g => g.items.length > 0);

// Items sin categoría reconocida
const assignedIds = new Set(groups.flatMap(g => g.items.map((i: any) => i.id)));
const ungrouped = items.filter(i => !assignedIds.has(i.id));
if (ungrouped.length) groups.push({ cat: { id: '__otros', name: 'Otros' }, items: ungrouped });
---

<!DOCTYPE html>
<html lang="es-CO">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Catálogo — Procalzado</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;600;700&family=Bebas+Neue&display=swap"/>
<style>
:root{--red:#FF0000;--black:#000;--white:#fff;--grey:#F2F2F2;--grey2:#E5E5E5;--muted:#4A4A4A;--fd:'Bebas Neue','Barlow',sans-serif;--fb:'Barlow',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--fb);background:var(--white);color:var(--black)}
.catalog-header{background:var(--black);color:var(--white);padding:1.4rem clamp(1rem,4vw,3rem);display:flex;align-items:center;gap:1.2rem;border-bottom:4px solid var(--red)}
.catalog-header img{height:28px;width:auto;display:block}
.catalog-header h1{font-family:var(--fd);font-size:1.5rem;letter-spacing:.06em}
.catalog-body{max-width:1400px;margin:0 auto;padding:2rem clamp(1rem,4vw,3rem) 4rem}
/* Carpeta / acordeón por categoría */
.cat-section{margin-bottom:1rem;border:1.5px solid var(--grey2);border-radius:10px;overflow:hidden}
.cat-folder{display:flex;align-items:center;gap:.7rem;padding:.9rem 1.1rem;cursor:pointer;background:var(--black);color:var(--white);user-select:none;border:none;width:100%;text-align:left}
.cat-folder:hover{background:#111}
.cat-folder-icon{font-size:1.1rem;transition:transform .2s}
.cat-folder.open .cat-folder-icon{transform:rotate(90deg)}
.cat-folder-name{font-family:var(--fd);font-size:1.5rem;letter-spacing:.06em;flex:1}
.cat-folder-count{font-size:.75rem;background:var(--red);color:#fff;border-radius:20px;padding:.1rem .55rem;font-family:var(--fb);font-weight:700}
.cat-body{display:none;padding:1rem}
.cat-body.open{display:block}

.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:1rem}
.product-card{background:var(--grey);border-radius:8px;overflow:hidden}
/* Carrusel */
.product-card-imgs{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;-ms-overflow-style:none;-webkit-overflow-scrolling:touch}
.product-card-imgs::-webkit-scrollbar{display:none}
.product-card-img{width:100%;aspect-ratio:1;object-fit:contain;display:block;background:#fff;pointer-events:none}
.product-card-img-placeholder{width:100%;aspect-ratio:1;background:var(--grey2);display:flex;align-items:center;justify-content:center;font-size:3rem}
.product-card-dots{display:flex;justify-content:center;gap:4px;padding:.35rem 0 .15rem}
.product-card-dot{width:6px;height:6px;border-radius:50%;background:var(--grey2);transition:background .15s}
.product-card-dot.active{background:var(--red)}
.product-card-body{padding:.6rem .7rem .8rem}
.product-card-brand{font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin-bottom:.1rem}
.product-card-name{font-family:var(--fd);font-size:1.05rem;letter-spacing:.03em;line-height:1.15}
@media print{
  .catalog-header{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .cat-folder{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .cat-body{display:block!important}
  .product-grid{grid-template-columns:repeat(4,1fr)}
}
@media(max-width:480px){
  .product-grid{grid-template-columns:repeat(2,1fr);gap:.6rem}
}
/* Modal */
.pmodal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:9999;align-items:center;justify-content:center;padding:1rem}
.pmodal-bg.open{display:flex}
.pmodal{background:var(--white);border-radius:12px;max-width:480px;width:100%;overflow:hidden;display:flex;flex-direction:column;position:relative}
.pmodal-close{position:absolute;top:.6rem;right:.7rem;background:rgba(0,0,0,.55);color:#fff;border:none;border-radius:50%;width:32px;height:32px;font-size:1.1rem;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center;line-height:1}
/* Carrusel controlado por transform */
.pmodal-stage{position:relative;width:100%;background:#fff;overflow:hidden;height:min(75vw,400px)}
.pmodal-track{display:flex;height:100%;transition:transform .3s ease;will-change:transform}
.pmodal-img{flex:0 0 100%;width:100%;height:100%;object-fit:contain;background:#fff;display:block}
.pmodal-arr{position:absolute;top:50%;transform:translateY(-50%);background:rgba(0,0,0,.45);color:#fff;border:none;border-radius:50%;width:38px;height:38px;font-size:1.4rem;cursor:pointer;z-index:2;display:flex;align-items:center;justify-content:center;line-height:1;transition:background .15s}
.pmodal-arr:hover{background:rgba(0,0,0,.7)}
.pmodal-arr-prev{left:8px}
.pmodal-arr-next{right:8px}
.pmodal-dots{display:flex;justify-content:center;gap:5px;padding:.45rem 0 .2rem}
.pmodal-dot{width:7px;height:7px;border-radius:50%;background:var(--grey2);transition:background .15s;cursor:pointer;border:none}
.pmodal-dot.active{background:var(--red)}
.pmodal-body{padding:.8rem 1rem 1.1rem}
.pmodal-brand{font-size:.65rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:.2rem}
.pmodal-name{font-family:var(--fd);font-size:1.6rem;letter-spacing:.04em;line-height:1.15}
</style>
</head>
<body>

<div class="catalog-header">
  <img src="/logotipo-rojo.png" alt="Procalzado"/>
  <h1>CATÁLOGO DE PRODUCTOS</h1>
</div>

<div class="catalog-body">
  {groups.length === 0 ? (
    <p style="text-align:center;padding:4rem;color:var(--muted)">El catálogo está vacío. Agrega productos desde el panel de administración.</p>
  ) : groups.map(({ cat, items }, gi) => (
    <div class="cat-section">
      <button class={`cat-folder${gi===0?' open':''}`} data-folder={`folder-${gi}`} type="button">
        <span class="cat-folder-icon">▶</span>
        <span class="cat-folder-name">{cat.name}</span>
        <span class="cat-folder-count">{items.length}</span>
      </button>
      <div class={`cat-body${gi===0?' open':''}`} id={`folder-${gi}`}>
      <div class="product-grid">
        {items.map((it: any) => {
          const p = it.products;
          const urls: string[] = (Array.isArray(it.image_urls) && it.image_urls.length)
            ? it.image_urls
            : (it.image_url ? [it.image_url]
              : [p?.product_images?.find((i: any) => i.is_primary)?.url || p?.product_images?.[0]?.url].filter(Boolean));
          return (
            <div class="product-card" style="cursor:pointer"
              data-urls={JSON.stringify(urls)}
              data-brand={p?.brands?.name || ''}
              data-name={p?.name || ''}
              onclick="window.openCatalogModal(this)">
              {urls.length > 0
                ? <img src={urls[0]} alt={p?.name || ''} class="product-card-img" loading="lazy" style="width:100%;aspect-ratio:1;object-fit:contain;background:#fff;display:block"/>
                : <div class="product-card-img-placeholder">👢</div>
              }
              <div class="product-card-body">
                {p?.brands?.name && <div class="product-card-brand">{p.brands.name}</div>}
                <div class="product-card-name">{p?.name}</div>
              </div>
            </div>
          );
        })}
      </div>
      </div>
    </div>
  ))}
</div>

<!-- Modal producto -->
<div class="pmodal-bg" id="pmodal">
  <div class="pmodal">
    <button class="pmodal-close" onclick="document.getElementById('pmodal').classList.remove('open')">×</button>
    <div class="pmodal-stage">
      <div class="pmodal-track" id="pmodalTrack"></div>
      <button class="pmodal-arr pmodal-arr-prev" id="pmodalPrev">&#8249;</button>
      <button class="pmodal-arr pmodal-arr-next" id="pmodalNext">&#8250;</button>
    </div>
    <div class="pmodal-dots" id="pmodalDots"></div>
    <div class="pmodal-body">
      <div class="pmodal-brand" id="pmodalBrand"></div>
      <div class="pmodal-name" id="pmodalName"></div>
    </div>
  </div>
</div>

<script is:inline>
// Carpetas colapsables
document.querySelectorAll('.cat-folder').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.getAttribute('data-folder');
    const body = document.getElementById(id);
    const isOpen = btn.classList.contains('open');
    btn.classList.toggle('open', !isOpen);
    body.classList.toggle('open', !isOpen);
  });
});

// Modal de producto
const pmodal = document.getElementById('pmodal');
const pmodalTrack = document.getElementById('pmodalTrack');
const pmodalDots = document.getElementById('pmodalDots');
const pmodalBrand = document.getElementById('pmodalBrand');
const pmodalName = document.getElementById('pmodalName');
const pmodalPrev = document.getElementById('pmodalPrev');
const pmodalNext = document.getElementById('pmodalNext');
let modalIdx = 0;
let modalTotal = 0;
let modalTouchX = 0;

function modalGo(idx) {
  modalIdx = Math.max(0, Math.min(idx, modalTotal - 1));
  pmodalTrack.style.transform = `translateX(-${modalIdx * 100}%)`;
  pmodalDots.querySelectorAll('.pmodal-dot').forEach((d, i) => d.classList.toggle('active', i === modalIdx));
  pmodalPrev.style.display = modalTotal > 1 && modalIdx > 0 ? 'flex' : 'none';
  pmodalNext.style.display = modalTotal > 1 && modalIdx < modalTotal - 1 ? 'flex' : 'none';
}

pmodalPrev.addEventListener('click', () => modalGo(modalIdx - 1));
pmodalNext.addEventListener('click', () => modalGo(modalIdx + 1));

pmodalTrack.addEventListener('touchstart', e => { modalTouchX = e.touches[0].clientX; }, { passive: true });
pmodalTrack.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].clientX - modalTouchX;
  if (Math.abs(dx) > 40) modalGo(dx < 0 ? modalIdx + 1 : modalIdx - 1);
}, { passive: true });

window.openCatalogModal = (card) => {
  const urls = JSON.parse(card.getAttribute('data-urls') || '[]');
  pmodalBrand.textContent = card.getAttribute('data-brand') || '';
  pmodalName.textContent = card.getAttribute('data-name') || '';
  pmodalTrack.innerHTML = urls.map(u => `<img src="${u}" class="pmodal-img"/>`).join('');
  modalTotal = urls.length;
  modalIdx = 0;
  pmodalTrack.style.transition = 'none';
  pmodalTrack.style.transform = 'translateX(0)';
  setTimeout(() => { pmodalTrack.style.transition = 'transform .3s ease'; }, 30);
  if (urls.length > 1) {
    pmodalDots.innerHTML = urls.map((_, i) => `<button class="pmodal-dot${i===0?' active':''}" onclick="modalGo(${i})"></button>`).join('');
    pmodalDots.style.display = 'flex';
  } else {
    pmodalDots.innerHTML = '';
    pmodalDots.style.display = 'none';
  }
  pmodalPrev.style.display = 'none';
  pmodalNext.style.display = urls.length > 1 ? 'flex' : 'none';
  pmodal.classList.add('open');
};

pmodal.addEventListener('click', e => { if (e.target === pmodal) pmodal.classList.remove('open'); });
document.addEventListener('keydown', e => {
  if (!pmodal.classList.contains('open')) return;
  if (e.key === 'Escape') pmodal.classList.remove('open');
  if (e.key === 'ArrowLeft') modalGo(modalIdx - 1);
  if (e.key === 'ArrowRight') modalGo(modalIdx + 1);
});
</script>
</body>
</html>
