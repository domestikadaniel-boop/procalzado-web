---
import { getCatalogItems, getProducts, getCategories } from '../lib/supabase';

const [products, catalogItems, allCats] = await Promise.all([
  getProducts(),
  getCatalogItems(),
  getCategories(),
]);

// Mapa de fotos personalizadas por product_id
const photoOverrides: Record<string, string[]> = {};
for (const ci of catalogItems) {
  if (Array.isArray((ci as any).image_urls) && (ci as any).image_urls.length) {
    photoOverrides[ci.product_id] = (ci as any).image_urls;
  } else if ((ci as any).image_url) {
    photoOverrides[ci.product_id] = [(ci as any).image_url];
  }
}

// URLs de fotos para un producto (override o todas las fotos del producto)
function getUrls(p: any): string[] {
  if (photoOverrides[p.id]) return photoOverrides[p.id];
  const imgs = (p.product_images || []).slice().sort((a: any, b: any) => a.display_order - b.display_order);
  const primary = imgs.find((i: any) => i.is_primary);
  const ordered = primary ? [primary, ...imgs.filter((i: any) => !i.is_primary)] : imgs;
  return ordered.map((i: any) => i.url);
}

// Resolver categoría madre de un producto
const parentCats = allCats.filter(c => !c.parent_id);
function getParentCatId(p: any): string | null {
  const pc = p.product_categories?.find((x: any) => x.is_primary) || p.product_categories?.[0];
  const cat = pc?.categories || p.categories;
  if (!cat) return null;
  return cat.parent_id || cat.id;
}

// Agrupar por categoría madre
const groups: { cat: any; items: any[] }[] = parentCats.map(cat => {
  const childIds = allCats.filter(c => c.parent_id === cat.id).map(c => c.id);
  const grouped = products.filter(p => {
    const pid = getParentCatId(p);
    return pid === cat.id || childIds.includes(pid || '');
  });
  return { cat, items: grouped };
}).filter(g => g.items.length > 0);

const assignedIds = new Set(groups.flatMap(g => g.items.map((p: any) => p.id)));
const ungrouped = products.filter(p => !assignedIds.has(p.id));
if (ungrouped.length) groups.push({ cat: { id: '__otros', name: 'Otros' }, items: ungrouped });
---

<!DOCTYPE html>
<html lang="es-CO">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Catálogo — Procalzado</title>
<meta name="robots" content="noindex,nofollow"/>
<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;600;700&family=Bebas+Neue&display=swap"/>
<style>
:root{--red:#FF0000;--black:#000;--white:#fff;--grey:#F2F2F2;--grey2:#E5E5E5;--muted:#4A4A4A;--fd:'Bebas Neue','Barlow',sans-serif;--fb:'Barlow',sans-serif}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--fb);background:var(--white);color:var(--black)}
/* HEADER */
.catalog-header{background:linear-gradient(to right,#3a0000 0%,#8a0000 25%,#cc0000 55%,#ff0000 80%,#ff1a00 100%);color:var(--white);padding:clamp(1.8rem,5vw,3rem) clamp(1.5rem,5vw,4rem) clamp(2rem,5vw,3.2rem);display:flex;flex-direction:column;align-items:flex-start}
.catalog-header-logo{height:20px;width:auto;display:block;margin-bottom:1.4rem;opacity:.9}
.catalog-header-title{font-family:var(--fd);font-size:clamp(2.8rem,8vw,5.5rem);letter-spacing:.04em;line-height:1;color:#fff;margin-bottom:.4rem}
.catalog-header-tag{font-family:var(--fb);font-size:clamp(.82rem,1.8vw,1rem);color:rgba(255,255,255,.72);font-weight:300;letter-spacing:.02em}
/* BODY */
.catalog-body{max-width:1400px;margin:0 auto;padding:2.5rem clamp(1.2rem,4vw,3.5rem) 5rem;display:flex;flex-direction:column;gap:2.2rem}
/* CATEGORÍA */
.cat-section{}
.cat-folder{display:flex;align-items:center;gap:.6rem;padding:0;cursor:pointer;background:none;color:var(--black);user-select:none;border:none;width:100%;text-align:left;margin-bottom:.6rem}
.cat-folder:hover .cat-folder-name{opacity:.75}
.cat-folder-icon{display:inline-block;flex-shrink:0;font-size:1.4rem;line-height:1;color:var(--black);transition:transform .22s;font-weight:300}
.cat-folder.open .cat-folder-icon{transform:rotate(90deg)}
.cat-folder-title{font-family:var(--fd);font-size:clamp(1.6rem,4vw,2.4rem);letter-spacing:.05em;flex:1;line-height:1}
.cat-folder-title .cat-name-base{color:var(--black)}
.cat-folder-title .cat-name-last{color:var(--red)}
.cat-folder-count{font-size:.65rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#aaa;white-space:nowrap}
.cat-divider{height:2px;background:var(--black);margin-bottom:1.4rem}
.cat-body{display:none}
.cat-body.open{display:block}
/* GRID */
.product-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:1.4rem}
.product-card{background:none;cursor:pointer;transition:transform .18s}
.product-card:hover{transform:translateY(-3px)}
.product-card-img-wrap{border-radius:12px;overflow:hidden;background:#f4f4f4;aspect-ratio:1;margin-bottom:.55rem}
.product-card-img{width:100%;height:100%;object-fit:contain;display:block;pointer-events:none}
.product-card-img-placeholder{width:100%;aspect-ratio:1;background:#f0f0f0;display:flex;align-items:center;justify-content:center;font-size:2.5rem;border-radius:12px;margin-bottom:.55rem}
.product-card-body{padding:0 .1rem}
.product-card-brand{font-size:.6rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--red);margin-bottom:.1rem}
.product-card-name{font-family:var(--fd);font-size:1.15rem;letter-spacing:.03em;line-height:1.15;color:var(--black);font-weight:700}
@media print{
  .catalog-header{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  .cat-body{display:block!important}
  .product-grid{grid-template-columns:repeat(4,1fr)}
}
@media(max-width:600px){
  .product-grid{grid-template-columns:repeat(2,1fr);gap:.75rem}
}
/* Modal */
.pmodal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:9999;align-items:center;justify-content:center;padding:1.2rem}
.pmodal-bg.open{display:flex}
.pmodal{background:var(--white);border-radius:20px;max-width:560px;width:100%;overflow:hidden;display:flex;flex-direction:column;position:relative;max-height:92vh}
.pmodal-close{position:absolute;top:.75rem;right:.75rem;background:rgba(255,255,255,.9);color:var(--black);border:none;border-radius:50%;width:36px;height:36px;font-size:1.2rem;cursor:pointer;z-index:3;display:flex;align-items:center;justify-content:center;line-height:1;box-shadow:0 2px 8px rgba(0,0,0,.18);font-weight:700}
.pmodal-stage{position:relative;width:100%;background:#f4f4f4;height:min(80vw,460px);flex-shrink:0}
.pmodal-img{width:100%;height:100%;object-fit:contain;display:block}
.pmodal-arr{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.9);color:var(--black);border:none;border-radius:50%;width:40px;height:40px;font-size:1.5rem;cursor:pointer;z-index:2;display:flex;align-items:center;justify-content:center;line-height:1;box-shadow:0 2px 8px rgba(0,0,0,.15);transition:background .15s;font-weight:300}
.pmodal-arr:hover{background:#fff}
.pmodal-arr-prev{left:12px}
.pmodal-arr-next{right:12px}
.pmodal-dots{display:flex;justify-content:center;align-items:center;gap:7px;padding:.55rem 0 .2rem}
.pmodal-body{padding:1rem 1.4rem 1.5rem}
.pmodal-brand{font-size:.65rem;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--red);margin-bottom:.25rem}
.pmodal-name{font-family:var(--fd);font-size:2rem;letter-spacing:.04em;line-height:1.1;color:var(--black)}
</style>
</head>
<body>

<div class="catalog-header">
  <img src="/logotipo.png" alt="Procalzado" class="catalog-header-logo"/>
  <div class="catalog-header-title">CATÁLOGO PROCALZADO</div>
  <div class="catalog-header-tag">Encuentra todo lo que necesitas</div>
</div>

<div class="catalog-body">
  {groups.length === 0 ? (
    <p style="text-align:center;padding:4rem;color:var(--muted)">El catálogo está vacío. Agrega productos desde el panel de administración.</p>
  ) : groups.map(({ cat, items }, gi) => (
    <div class="cat-section">
      {(() => {
        const words = cat.name.trim().split(' ');
        const last = words.pop();
        const base = words.join(' ');
        return (
          <button class="cat-folder" data-folder={`folder-${gi}`} type="button">
            <span class="cat-folder-icon">›</span>
            <span class="cat-folder-title">
              {base && <span class="cat-name-base">{base} </span>}
              <span class="cat-name-last">{last}</span>
            </span>
            <span class="cat-folder-count">{items.length} PRODUCTOS</span>
          </button>
        );
      })()}
      <div class="cat-divider"></div>
      <div class="cat-body" id={`folder-${gi}`}>
      <div class="product-grid">
        {items.map((p: any) => {
          const urls = getUrls(p);
          return (
            <div class="product-card" style="cursor:pointer"
              data-urls={urls.join('|')}
              data-brand={p.brands?.name || ''}
              data-name={p.name || ''}
              onclick="window.openCatalogModal(this)">
              {urls.length > 0
                ? <div class="product-card-img-wrap"><img src={urls[0]} alt={p.name || ''} class="product-card-img" loading="lazy"/></div>
                : <div class="product-card-img-placeholder">👢</div>
              }
              <div class="product-card-body">
                {p.brands?.name && <div class="product-card-brand">{p.brands.name}</div>}
                <div class="product-card-name">{p.name}</div>
              </div>
            </div>
          );
        })}
      </div>
      </div>
    </div>
  ))}
</div>

<!-- Modal producto -->
<div class="pmodal-bg" id="pmodal">
  <div class="pmodal">
    <button class="pmodal-close" onclick="document.getElementById('pmodal').classList.remove('open')">×</button>
    <div class="pmodal-stage">
      <img class="pmodal-img" id="pmodalImg" src="" alt=""/>
      <button class="pmodal-arr pmodal-arr-prev" id="pmodalPrev">&#8249;</button>
      <button class="pmodal-arr pmodal-arr-next" id="pmodalNext">&#8250;</button>
    </div>
    <div class="pmodal-dots" id="pmodalDots"></div>
    <div class="pmodal-body">
      <div class="pmodal-brand" id="pmodalBrand"></div>
      <div class="pmodal-name" id="pmodalName"></div>
    </div>
  </div>
</div>

<script is:inline>
// Carpetas colapsables
document.querySelectorAll('.cat-folder').forEach(btn => {
  btn.addEventListener('click', () => {
    const id = btn.getAttribute('data-folder');
    const body = document.getElementById(id);
    const isOpen = btn.classList.contains('open');
    btn.classList.toggle('open', !isOpen);
    body.classList.toggle('open', !isOpen);
  });
});

// Modal de producto
const pmodal = document.getElementById('pmodal');
const pmodalImg = document.getElementById('pmodalImg');
const pmodalDots = document.getElementById('pmodalDots');
const pmodalBrand = document.getElementById('pmodalBrand');
const pmodalName = document.getElementById('pmodalName');
const pmodalPrev = document.getElementById('pmodalPrev');
const pmodalNext = document.getElementById('pmodalNext');
let modalUrls = [];
let modalIdx = 0;
let modalTouchX = 0;

function modalGo(idx) {
  modalIdx = Math.max(0, Math.min(idx, modalUrls.length - 1));
  pmodalImg.src = modalUrls[modalIdx];
  pmodalDots.querySelectorAll('span[data-di]').forEach(d => { d.style.background = d.getAttribute('data-di') == modalIdx ? '#FF0000' : '#999'; });
  pmodalPrev.style.display = modalIdx > 0 ? 'flex' : 'none';
  pmodalNext.style.display = modalIdx < modalUrls.length - 1 ? 'flex' : 'none';
}

pmodalPrev.addEventListener('click', () => modalGo(modalIdx - 1));
pmodalNext.addEventListener('click', () => modalGo(modalIdx + 1));

pmodalImg.addEventListener('touchstart', e => { modalTouchX = e.touches[0].clientX; }, { passive: true });
pmodalImg.addEventListener('touchend', e => {
  const dx = e.changedTouches[0].clientX - modalTouchX;
  if (Math.abs(dx) > 40) modalGo(dx < 0 ? modalIdx + 1 : modalIdx - 1);
}, { passive: true });

window.openCatalogModal = (card) => {
  const rawUrls = card.getAttribute('data-urls') || '';
  modalUrls = rawUrls.split('|').filter(Boolean);
  pmodalBrand.textContent = card.getAttribute('data-brand') || '';
  pmodalName.textContent = card.getAttribute('data-name') || '';
  modalIdx = 0;
  pmodalImg.src = modalUrls[0] || '';
  const multi = modalUrls.length > 1;
  pmodalDots.innerHTML = multi
    ? modalUrls.map((_, i) => `<span data-di="${i}" style="width:12px;height:12px;border-radius:50%;background:${i===0?'#FF0000':'#999'};display:block;flex-shrink:0;cursor:pointer;transition:background .2s"></span>`).join('')
    : '';
  pmodalDots.style.display = multi ? 'flex' : 'none';
  pmodalPrev.style.display = 'none';
  pmodalNext.style.display = multi ? 'flex' : 'none';
  // click en dots
  pmodalDots.querySelectorAll('span[data-di]').forEach((d, i) => {
    d.addEventListener('click', () => modalGo(i));
  });
  pmodal.classList.add('open');
};

pmodal.addEventListener('click', e => { if (e.target === pmodal) pmodal.classList.remove('open'); });
document.addEventListener('keydown', e => {
  if (!pmodal.classList.contains('open')) return;
  if (e.key === 'Escape') pmodal.classList.remove('open');
  if (e.key === 'ArrowLeft') modalGo(modalIdx - 1);
  if (e.key === 'ArrowRight') modalGo(modalIdx + 1);
});
</script>
</body>
</html>
